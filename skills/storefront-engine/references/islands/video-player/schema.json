{
  "contract_version": 2,
  "name": "VideoPlayer",
  "category": "content",
  "capabilities": [],
  "usage_hint": "Responsive video player with controls, autoplay, loop. Supports direct video files and YouTube/Vimeo embeds.",
  "when_to_use": "For product demos, how-to videos, brand stories. Auto-detects YouTube/Vimeo URLs and renders iframe embed. For direct videos shows custom controls (play/pause, progress, mute). Poster image for thumbnail.",
  "when_not_to_use": "For background ambient video use HTML5 video tag directly. For short animated clips consider GIF or CSS animations. When video isn't core to conversion.",
  "defaultHydrate": "immediate",
  "combine_with": [
    "ProductImage",
    "Hero sections",
    "ProductDescription"
  ],
  "anti_patterns": [
    "Autoplaying unmuted video (violates accessibility and most browsers block it)",
    "Using large uncompressed video files (>5MB — slows page load)",
    "Not providing poster image (shows blank frame until video loads)"
  ],
  "props": {
    "src": {
      "type": "string",
      "required": false
    },
    "media": {
      "type": "object",
      "shape": {
        "assetId": "?string",
        "provider": "?'cloudflare_stream' | 'cloudflare_cdn' | 'external'",
        "sources": "array<{url: string, type: 'application/x-mpegURL' | 'application/vnd.apple.mpegurl' | 'application/dash+xml' | 'video/mp4' | 'video/webm' | 'video/ogg', width: ?number, height: ?number, bitrate: ?number}>",
        "poster": "string",
        "preview": "?{url: string, type: 'video/mp4' | 'image/gif' | 'image/webp', poster: ?object}",
        "captionsUrl": "?string"
      },
      "required": false
    },
    "poster": {
      "type": "string",
      "required": false
    },
    "autoplay": {
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    "muted": {
      "type": "boolean",
      "required": false
    },
    "loop": {
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    "aspectRatio": {
      "type": "string",
      "required": false,
      "default": "16/9"
    }
  },
  "variants": null,
  "css_vars": [
    "--lx-accent-color",
    "--lx-bg-surface",
    "--lx-featured-media-arrow-bg",
    "--lx-featured-media-arrow-border",
