  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    },
    "example": "<lx-island name=\"VideoPlayer\">\n  <script type=\"application/json\">\n{}\n  </script>\n</lx-island>",
    "examples": [
      {
        "label": "Direct video with poster",
        "source": "<lx-island name=\"VideoPlayer\">\n  <script type=\"application/json\">{\"src\":\"/videos/product-demo.mp4\",\"poster\":\"/images/video-poster.jpg\",\"autoplay\":false,\"muted\":false,\"loop\":false,\"aspectRatio\":\"16/9\"}</script>\n</lx-island>"
      },
      {
        "label": "YouTube embed with autoplay",
        "source": "<lx-island name=\"VideoPlayer\">\n  <script type=\"application/json\">{\"src\":\"https://www.youtube.com/watch?v=dQw4w9WgXcQ\",\"poster\":\"/images/yt-thumb.jpg\",\"autoplay\":true,\"aspectRatio\":\"16/9\"}</script>\n</lx-island>"
      },
      {
        "label": "Vimeo embed looping",
        "source": "<lx-island name=\"VideoPlayer\">\n  <script type=\"application/json\">{\"src\":\"https://vimeo.com/123456789\",\"autoplay\":true,\"muted\":true,\"loop\":true,\"aspectRatio\":\"16/9\"}</script>\n</lx-island>"
      }
    ]
  }
