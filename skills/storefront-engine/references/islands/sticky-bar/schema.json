{
  "contract_version": 2,
  "name": "StickyBar",
  "category": "commerce",
  "capabilities": [
    {
      "name": "product:resolve"
    },
    {
      "name": "cart:add"
    },
    {
      "name": "cart:open"
    },
    {
      "name": "overlay"
    }
  ],
  "usage_hint": "Sticky bottom CTA for either a bound product add-to-cart or a collection/campaign destination.",
  "when_to_use": "Use below the fold to re-surface a PDP add-to-cart or keep a collection-level shopping CTA available.",
  "when_not_to_use": "Not for initial purchase UI (use BuyBox or QuickAdd). Not if the primary CTA remains visible in the layout.",
  "defaultHydrate": "immediate",
  "combine_with": [
    "BuyBox (StickyBar appears AFTER scrolling past BuyBox)",
    "CartDrawer (REQUIRED for cart feedback)",
    "ProductGallery or ProductHero (provides context above the fold)"
  ],
  "anti_patterns": [
    "Using a product StickyBar without a primary purchase interface",
    "Omitting showAfter or misconfiguring it: bar may appear too early or not at all",
    "Missing CartDrawer: users get no cart feedback after clicking the sticky bar CTA"
  ],
  "props": {
    "product": {
      "type": "object",
      "shape": {
        "title": "string",
        "price": "string",
        "compareAtPrice": "?string",
        "image": "?string",
        "variantId": "string"
      },
      "required": false
    },
    "collection": {
      "type": "object",
      "shape": {
        "label": "string",
        "url": "string",
        "subtitle": "?string",
        "image": "?string"
      },
      "required": false
    },
    "cta": {
      "type": "string",
      "required": false,
      "default": "Add to Cart"
    },
    "showAfter": {
      "type": "union",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        }
      ],
      "required": false
    },
    "animate": {
      "type": "union",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        }
      ],
      "required": false,
      "default": "true"
    }
  },
  "variants": null,
  "css_vars": [
    "--lx-accent-color",
    "--lx-text-color"
  ],
  "parts": [
    "bar",
    "cta",
    "product-image",
    "product-info",
    "product-price",
    "product-title",
    "root"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    },
    "example": "<lx-island name=\"StickyBar\">\n  <script type=\"application/json\">\n{}\n  </script>\n</lx-island>",
    "examples": [
      {
        "label": "Default sticky bar (appears after BuyBox)",
        "source": "<lx-island name=\"StickyBar\">\n  <script type=\"application/json\">{\"product\":{\"title\":\"Wireless Headphones\",\"price\":\"$99.00\",\"compareAtPrice\":\"$129.00\",\"image\":\"https://via.placeholder.com/40\",\"variantId\":\"v1\"},\"cta\":\"Add to Cart\"}</script>\n</lx-island>"
      },
      {
        "label": "Sticky bar with custom trigger selector",
        "source": "<lx-island name=\"StickyBar\">\n  <script type=\"application/json\">{\"product\":{\"title\":\"Watch\",\"price\":\"$249.00\",\"variantId\":\"v1\"},\"cta\":\"Buy Now\",\"showAfter\":\"#product-details\"}</script>\n</lx-island>"
      },
      {
        "label": "Sticky bar revealed after 800px of scroll",
        "source": "<lx-island name=\"StickyBar\">\n  <script type=\"application/json\">{\"product\":{\"title\":\"Watch\",\"price\":\"$249.00\",\"variantId\":\"v1\"},\"cta\":\"Buy Now\",\"showAfter\":800}</script>\n</lx-island>"
      },
      {
        "label": "Sticky bar without animations",
        "source": "<lx-island name=\"StickyBar\">\n  <script type=\"application/json\">{\"product\":{\"title\":\"Sneakers\",\"price\":\"$120.00\",\"image\":\"https://via.placeholder.com/40\",\"variantId\":\"v1\"},\"animate\":false}</script>\n</lx-island>"
      },
      {
        "label": "Collection campaign CTA",
        "source": "<lx-island name=\"StickyBar\">\n  <script type=\"application/json\">{\"collection\":{\"label\":\"Shop Karva Chauth gifts\",\"url\":\"#for-her\",\"subtitle\":\"Gifts from ₹899\"},\"showAfter\":\"#who-are-you-gifting\"}</script>\n</lx-island>"
      }
    ]
  }
}
