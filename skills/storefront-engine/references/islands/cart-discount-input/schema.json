{
  "contract_version": 2,
  "name": "CartDiscountInput",
  "category": "commerce",
  "usage_hint": "Discount code input with apply/remove functionality. Calls Shopify cart discount API.",
  "when_to_use": "Inside DrawerShell between CartSummary and CartCheckoutButton to allow discount code entry.",
  "when_not_to_use": "If the store does not support discount codes or discounts are auto-applied only.",
  "defaultHydrate": "immediate",
  "combine_with": [
    "DrawerShell",
    "CartSummary",
    "CartCheckoutButton"
  ],
  "anti_patterns": [],
  "props": {
    "placeholder": {
      "type": "string",
      "required": false,
      "default": "Discount code"
    },
    "autoApply": {
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    "showRemove": {
      "type": "boolean",
      "required": false,
      "default": "true"
    }
  },
  "variants": null,
  "css_vars": [
    "--lx-accent-color"
  ],
  "parts": [
    "applied-badge",
    "applied-code",
    "button",
    "error",
    "form",
    "input",
    "remove-btn",
    "root"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    },
    "example": "<lx-island name=\"CartDiscountInput\">\n  <script type=\"application/json\">\n{}\n  </script>\n</lx-island>",
    "examples": []
  }
}
