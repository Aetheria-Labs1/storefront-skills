{
  "contract_version": 2,
  "name": "StatCards",
  "category": "social_proof",
  "capabilities": [],
  "deprecated": true,
  "replacement": "HTML/CSS with optional IntersectionObserver",
  "deprecation_reason": "Generic count-up presentation has no Shopify scope and should be authored in the page section.",
  "usage_hint": "Compatibility contract for existing pages. Do not author this retired island in new source.",
  "when_to_use": "Inspect an existing page only; use the replacement in workflows/island-selection-workflow.md for new source.",
  "when_not_to_use": "Do not use for new page authoring.",
  "defaultHydrate": "visible",
  "combine_with": [],
  "anti_patterns": [
    "Too many items (>6): overwhelming and dilutes impact \u2014 pick top 3-4 metrics",
    "Placing below fold where animation isn't seen on first load (defeats the purpose of count-up)",
    "Using with animate:false AND glass style (static glass cards look like broken UI without the reveal)",
    "Decimal values with long suffixes (e.g. 99.87% satisfaction) \u2014 round for impact"
  ],
  "props": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "shape": {
          "value": "number",
          "suffix": "?string",
          "prefix": "?string",
          "label": "string",
          "sublabel": "?string"
        }
      },
      "shape": {
        "value": "number",
        "suffix": "?string",
        "prefix": "?string",
        "label": "string",
        "sublabel": "?string"
      },
      "required": true
    },
    "layout": {
      "type": "enum",
      "values": [
        "horizontal",
        "vertical",
        "inline"
      ],
      "required": false,
      "default": "horizontal"
    },
    "style": {
      "type": "enum",
      "values": [
        "headless",
        "solid",
        "glass",
        "gradient"
      ],
      "required": false,
      "default": "glass"
    },
    "animate": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "duration": {
      "type": "number",
      "required": false,
      "default": "2000"
    },
    "threshold": {
      "type": "number",
      "required": false,
      "default": "0.3"
    },
    "stagger": {
      "type": "number",
      "required": false,
      "default": "200"
    }
  },
  "variants": [
    "headless",
    "solid",
    "glass",
    "gradient"
  ],
  "css_vars": [
    "--lx-stat-bg",
    "--lx-stat-blur",
    "--lx-stat-border",
    "--lx-stat-gap",
    "--lx-stat-gradient",
    "--lx-stat-label-color",
    "--lx-stat-number-color",
    "--lx-stat-number-size",
    "--lx-stat-padding",
    "--lx-stat-radius",
    "--lx-stat-sublabel-color"
  ],
  "parts": [
    "item",
    "label",
    "number",
    "prefix",
    "root",
    "sublabel",
    "suffix"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    }
  }
}
