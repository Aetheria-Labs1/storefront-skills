{
  "contract_version": 2,
  "name": "QuickAdd",
  "category": "commerce",
  "capabilities": [
    {
      "name": "product:resolve"
    },
    {
      "name": "cart:add"
    },
    {
      "name": "cart:open"
    }
  ],
  "usage_hint": "Accessible collection-page Quick Add using instant single-variant add and a responsive multi-variant drawer or bottom sheet.",
  "when_to_use": "Use on collection pages where customers should select a variant and add without navigating to the PDP.",
  "when_not_to_use": "Not for the main PDP purchase form (use BuyBox) or products requiring quantity, subscriptions, or complex personalization.",
  "defaultHydrate": "interaction",
  "combine_with": [
    "Cart V2 or CartDrawer"
  ],
  "anti_patterns": [
    "Hardcoding a variant ID for a multi-variant product",
    "Using selector-driven custom triggers for new pages",
    "Hiding sold-out state instead of disabling unavailable variants"
  ],
  "props": {
    "product": {
      "type": "object",
      "shape": {
        "image": "?string",
        "variants": "?array<{id: string, title: string, price: object | object, available: ?object | object, availableForSale: ?object | object, selectedOptions: ?object, image: ?object | object | object}>",
        "id": "?string",
        "productId": "?string",
        "shopifyProductId": "?string",
        "handle": "?string",
        "title": "?string",
        "description": "?string",
        "subtitle": "?string",
        "badge": "?string",
        "productUrl": "?string",
        "price": "?string | {amount: string, currencyCode: string}",
        "compareAtPrice": "?unknown | string | {amount: string, currencyCode: string}",
        "availableForSale": "?boolean | boolean",
        "available": "?boolean | boolean",
        "media": "?array<object | object>",
        "options": "?array<object | object>",
        "variantId": "?string"
      },
      "required": true
    },
    "render": {
      "type": "enum",
      "values": [
        "minimal",
        "button",
        "icon",
        "custom-trigger"
      ],
      "required": false,
      "default": "button"
    },
    "iconSize": {
      "type": "number",
      "required": false
    },
    "label": {
      "type": "string",
      "required": false,
      "default": "Quick add"
    },
    "openCartOnAdd": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "picker": {
      "type": "object",
      "shape": {
        "desktop": "?'drawer-right'",
        "mobile": "?'bottom-sheet'",
        "title": "?string",
        "closeOnAdd": "?boolean | boolean"
      },
      "required": false
    },
    "config": {
      "type": "object",
      "shape": {
        "enabled": "?boolean | boolean",
        "placement": "?'media-top-right' | 'details-after' | 'custom'",
        "label": "?string",
        "openCartOnAdd": "?boolean | boolean",
        "picker": "?{desktop: ?'drawer-right', mobile: ?'bottom-sheet', title: ?object, closeOnAdd: ?object | object}"
      },
      "required": false
    },
    "triggerSelector": {
      "type": "string",
      "required": false,
      "deprecated": true,
      "description": "Use a native Quick Add trigger. Selector-driven triggers are\nretained temporarily for legacy authored pages."
    },
    "animate": {
      "type": "union",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        }
      ],
      "required": false,
      "default": "true"
    }
  },
  "variants": null,
  "css_vars": [
    "--lx-accent-color",
    "--lx-accent-contrast",
    "--lx-bg-color",
    "--lx-border-color",
    "--lx-error-color",
    "--lx-focus-color",
    "--lx-font-heading",
    "--lx-muted-color",
    "--lx-quick-add-backdrop",
    "--lx-quick-add-bg",
    "--lx-quick-add-button-radius",
    "--lx-quick-add-drawer-width",
    "--lx-quick-add-icon-bg",
    "--lx-quick-add-icon-color",
    "--lx-quick-add-icon-shadow",
    "--lx-quick-add-option-radius",
    "--lx-quick-add-shadow",
    "--lx-quick-add-sheet-height",
    "--lx-quick-add-trigger-bg",
    "--lx-quick-add-trigger-border",
    "--lx-quick-add-trigger-color",
    "--lx-quick-add-trigger-radius",
    "--lx-quick-add-z-index",
    "--lx-success-color",
    "--lx-surface-alt",
    "--lx-text-color"
  ],
  "parts": [
    "quick-add-backdrop",
    "quick-add-close",
    "quick-add-drag-handle",
    "quick-add-image",
    "quick-add-option",
    "quick-add-option-group",
    "quick-add-panel",
    "quick-add-price",
    "quick-add-selected-variant",
    "quick-add-sheet",
    "quick-add-status",
    "quick-add-submit",
    "quick-add-variant",
    "quick-add-variant-list",
    "root"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    },
    "example": "<lx-island name=\"QuickAdd\">\n  <script type=\"application/json\">\n{\n  \"product\": {}\n}\n  </script>\n</lx-island>",
    "examples": [
      {
        "label": "Canonical multi-variant quick add",
        "source": "<lx-island name=\"QuickAdd\">\n  <script type=\"application/json\">{\"product\":{\"id\":\"gid://shopify/Product/1\",\"handle\":\"shirt\",\"title\":\"Shirt\",\"price\":{\"amount\":\"29.00\",\"currencyCode\":\"USD\"},\"availableForSale\":true,\"media\":[{\"id\":\"gid://shopify/MediaImage/1\",\"type\":\"image\",\"url\":\"https://example.com/shirt.jpg\"}],\"options\":[{\"name\":\"Size\",\"values\":[\"S\",\"M\"]}],\"variants\":[{\"id\":\"gid://shopify/ProductVariant/1\",\"title\":\"Small\",\"availableForSale\":true,\"selectedOptions\":[{\"name\":\"Size\",\"value\":\"S\"}],\"price\":{\"amount\":\"29.00\",\"currencyCode\":\"USD\"}},{\"id\":\"gid://shopify/ProductVariant/2\",\"title\":\"Medium\",\"availableForSale\":true,\"selectedOptions\":[{\"name\":\"Size\",\"value\":\"M\"}],\"price\":{\"amount\":\"29.00\",\"currencyCode\":\"USD\"}}]},\"picker\":{\"title\":\"Choose a size\"}}</script>\n</lx-island>"
      },
      {
        "label": "Legacy single-variant compatibility",
        "source": "<lx-island name=\"QuickAdd\">\n  <script type=\"application/json\">{\"product\":{\"title\":\"Hat\",\"image\":\"https://example.com/hat.jpg\",\"variants\":[{\"id\":\"gid://shopify/ProductVariant/3\",\"title\":\"One Size\",\"price\":\"$19.00\",\"available\":true}]}}</script>\n</lx-island>"
      },
      {
        "label": "Compact icon trigger",
        "source": "<lx-island name=\"QuickAdd\">\n  <script type=\"application/json\">{\"render\":\"icon\",\"iconSize\":44,\"product\":{\"title\":\"Hat\",\"variants\":[{\"id\":\"gid://shopify/ProductVariant/3\",\"title\":\"One Size\",\"price\":\"$19.00\",\"available\":true}]}}</script>\n</lx-island>"
      }
    ]
  }
}
