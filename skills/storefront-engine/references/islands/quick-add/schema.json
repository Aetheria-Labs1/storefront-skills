{
  "contract_version": 2,
  "name": "QuickAdd",
  "category": "commerce",
  "capabilities": [
    {
      "name": "product:resolve"
    },
    {
      "name": "cart:add"
    },
    {
      "name": "cart:open"
    }
  ],
  "usage_hint": "Accessible collection-page Quick Add using instant single-variant add and a responsive multi-variant drawer or bottom sheet.",
  "when_to_use": "Use on collection pages where customers should select a variant and add without navigating to the PDP.",
  "when_not_to_use": "Not for the main PDP purchase form (use BuyBox) or products requiring quantity, subscriptions, or complex personalization.",
  "defaultHydrate": "interaction",
  "combine_with": [
    "The renderer-managed effective Cart V2 profile"
  ],
  "anti_patterns": [
    "Hardcoding a variant ID for a multi-variant product",
    "Using selector-driven custom triggers for new pages",
    "Hiding sold-out state instead of disabling unavailable variants"
  ],
  "props": {
    "product": {
      "type": "object",
      "shape": {
        "image": "?string",
        "variants": "?array<{id: string, title: string, price: string | object, available: ?boolean, availableForSale: ?boolean, selectedOptions: ?array<{}>, image: ?object | string | object}>",
        "id": "?string",
        "productId": "?string",
        "shopifyProductId": "?string",
        "handle": "?string",
        "title": "?string",
        "description": "?string",
        "subtitle": "?string",
        "badge": "?string",
        "productUrl": "?string",
        "price": "?string | {amount: string, currencyCode: string}",
        "compareAtPrice": "?unknown | string | {amount: string, currencyCode: string}",
        "availableForSale": "?boolean",
        "available": "?boolean",
        "media": "?array<object | object>",
        "options": "?array<object | object>",
        "variantId": "?string"
      },
      "required": true
    },
    "render": {
      "type": "enum",
      "values": [
        "minimal",
        "icon",
        "button",
        "custom-trigger"
      ],
      "required": false,
      "default": "button"
    },
    "iconSize": {
      "type": "number",
      "required": false
    },
    "label": {
      "type": "string",
      "required": false,
      "default": "Quick add"
    },
    "openCartOnAdd": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "picker": {
      "type": "object",
      "shape": {
        "desktop": "?'drawer-right'",
        "mobile": "?'bottom-sheet'",
        "title": "?string",
        "closeOnAdd": "?boolean"
      },
      "required": false
    },
    "config": {
      "type": "object",
      "shape": {
        "enabled": "?boolean",
        "placement": "?'media-top-right' | 'details-after' | 'custom'",
        "label": "?string",
        "triggerContent": "?string",
        "openCartOnAdd": "?boolean",
        "picker": "?{desktop: ?'drawer-right', mobile: ?'bottom-sheet', title: ?string, closeOnAdd: ?boolean}"
      },
      "required": false
    },
    "triggerSelector": {
      "type": "string",
      "required": false,
      "deprecated": true,
      "description": "Use a native Quick Add trigger. Selector-driven triggers are\nretained temporarily for legacy authored pages."
    },
    "animate": {
      "type": "union",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        }
      ],
      "required": false,
      "default": "true"
    }
  },
  "variants": null,
  "css_vars": [
    "--lx-accent-color",
    "--lx-accent-contrast",
    "--lx-bg-color",
    "--lx-border-color",
    "--lx-error-color",
    "--lx-focus-color",
    "--lx-font-heading",
    "--lx-muted-color",
    "--lx-quick-add-backdrop",
    "--lx-quick-add-bg",
    "--lx-quick-add-button-radius",
    "--lx-quick-add-drawer-width",
    "--lx-quick-add-icon-bg",
    "--lx-quick-add-icon-color",
    "--lx-quick-add-icon-shadow",
    "--lx-quick-add-option-radius",
    "--lx-quick-add-shadow",
    "--lx-quick-add-sheet-height",
    "--lx-quick-add-trigger-bg",
    "--lx-quick-add-trigger-border",
    "--lx-quick-add-trigger-color",
    "--lx-quick-add-trigger-radius",
    "--lx-quick-add-z-index",
    "--lx-success-color",
    "--lx-surface-alt",
    "--lx-text-color"
  ],
  "parts": [
    "quick-add-backdrop",
    "quick-add-body",
    "quick-add-close",
    "quick-add-drag-handle",
    "quick-add-eyebrow",
    "quick-add-footer",
    "quick-add-header",
    "quick-add-image",
    "quick-add-option",
    "quick-add-option-group",
    "quick-add-option-label",
    "quick-add-option-values",
    "quick-add-options",
    "quick-add-panel",
    "quick-add-price",
    "quick-add-product",
    "quick-add-product-copy",
    "quick-add-product-title",
    "quick-add-selected-variant",
    "quick-add-sheet",
    "quick-add-status",
    "quick-add-submit",
    "quick-add-title",
    "quick-add-variant",
    "quick-add-variant-list",
    "root"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    }
  }
}
