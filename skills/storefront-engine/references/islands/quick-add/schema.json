{
  "name": "QuickAdd",
  "category": "commerce",
  "usage_hint": "Lightweight add-to-cart button for collection pages. Shows single-variant instant add or multi-variant dropdown selector. Used inside ProductCarousel or standalone in grids.",
  "when_to_use": "Use on collection pages where space is limited and you need quick add-to-cart without navigating to PDP. Ideal for cards, grids, and list views.",
  "when_not_to_use": "Not for PDP main purchase UI (use BuyBox). Not for sticky follow-up CTAs (use StickyBar). Not when you need quantity selection or detailed variant info (use BuyBox).",
  "defaultHydrate": "interaction",
  "combine_with": [
    "CartDrawer (REQUIRED for cart feedback)",
    "ProductCarousel (QuickAdd is commonly used inside product grids)"
  ],
  "anti_patterns": [
    "Using on PDP: wrong pattern; PDP should use BuyBox for full purchase experience",
    "Omitting CartDrawer: users get no cart confirmation feedback",
    "Using for products with many variants (5+): dropdown becomes unwieldy; navigate to PDP instead",
    "Setting animate:false globally: removes dropdown scale-in and success checkmark animations"
  ],
  "examples": [
    {
      "label": "Single-variant quick add",
      "html": "<div data-island=\"QuickAdd\" data-props='{\"product\":{\"title\":\"T-Shirt\",\"variants\":[{\"id\":\"v1\",\"title\":\"Medium\",\"price\":\"$29.00\",\"available\":true}]}}'></div>"
    },
    {
      "label": "Multi-variant quick add with dropdown",
      "html": "<div data-island=\"QuickAdd\" data-props='{\"product\":{\"title\":\"Sneakers\",\"variants\":[{\"id\":\"v1\",\"title\":\"Size 8\",\"price\":\"$120.00\",\"available\":true},{\"id\":\"v2\",\"title\":\"Size 9\",\"price\":\"$120.00\",\"available\":true},{\"id\":\"v3\",\"title\":\"Size 10\",\"price\":\"$120.00\",\"available\":false}],\"image\":\"https://via.placeholder.com/64\"}}'></div>"
    },
    {
      "label": "Quick add without animations",
      "html": "<div data-island=\"QuickAdd\" data-props='{\"product\":{\"title\":\"Hat\",\"variants\":[{\"id\":\"v1\",\"title\":\"One Size\",\"price\":\"$19.00\",\"available\":true}]},\"animate\":false}'></div>"
    },
    {
      "label": "Icon mode quick add",
      "html": "<div data-island=\"QuickAdd\" data-props='{\"product\":{\"title\":\"T-Shirt\",\"variants\":[{\"id\":\"v1\",\"title\":\"Medium\",\"price\":\"$29.00\",\"available\":true}]},\"render\":\"icon\",\"iconSize\":40}'></div>"
    },
    {
      "label": "Minimal plus button",
      "html": "<div data-island=\"QuickAdd\" data-props='{\"product\":{\"title\":\"T-Shirt\",\"variants\":[{\"id\":\"v1\",\"title\":\"Medium\",\"price\":\"$29.00\",\"available\":true}]},\"render\":\"minimal\",\"iconSize\":32}'></div>"
    }
  ],
  "props": {
    "product": {
      "type": "object",
      "required": true,
      "shape": {
        "title": "string",
        "variants": "array<{id: string, title: string, price: string, available: boolean}>",
        "image": "?string"
      }
    },
    "render": {
      "type": "enum",
      "required": false,
      "values": [
        "minimal",
        "button",
        "icon",
        "custom-trigger"
      ],
      "default": "button"
    },
    "iconSize": {
      "type": "number",
      "required": false
    },
    "triggerSelector": {
      "type": "string",
      "required": false
    },
    "animate": {
      "type": "boolean",
      "required": false,
      "default": "true"
    }
  },
  "variants": null,
  "css_vars": [
    "--lx-accent-color",
    "--lx-quickadd-bg",
    "--lx-quickadd-color",
    "--lx-quickadd-radius",
    "--lx-quickadd-size"
  ],
  "parts": [
    "dropdown",
    "dropdown-label",
    "root",
    "variant-btn"
  ],
  "example": "<div data-island=\"QuickAdd\" data-props='{\"product\":{\"title\":\"example-title\",\"variants\":[]}}'></div>"
}
