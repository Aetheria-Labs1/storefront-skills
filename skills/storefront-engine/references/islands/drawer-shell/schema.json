{
  "contract_version": 2,
  "name": "DrawerShell",
  "category": "commerce",
  "capabilities": [
    {
      "name": "cart:open"
    },
    {
      "name": "overlay"
    }
  ],
  "usage_hint": "Multi-mode container island that lazily hydrates child islands on first open and keeps them mounted across subsequent opens.",
  "when_to_use": "Wrap CartLines, CartSummary, CartCheckoutButton, CartProgressBar, and CartCrossSell inside DrawerShell for a composable cart.",
  "when_not_to_use": "Do not use for always-visible content or nest one DrawerShell inside another.",
  "defaultHydrate": "immediate",
  "combine_with": [
    "CartLines",
    "CartSummary",
    "CartCheckoutButton",
    "CartProgressBar",
    "CartCrossSell"
  ],
  "anti_patterns": [
    "Omitting data-island-container (children hydrate eagerly instead of on first open)",
    "Nesting DrawerShell instances (focus, scroll locking, and overlays conflict)"
  ],
  "props": {
    "mode": {
      "type": "enum",
      "values": [
        "drawer-right",
        "drawer-left",
        "bottom-sheet",
        "modal",
        "fullscreen",
        "dropdown"
      ],
      "required": false,
      "default": "drawer-right"
    },
    "responsive": {
      "type": "object",
      "shape": {
        "mobile": "?string",
        "tablet": "?string"
      },
      "required": false
    },
    "trigger": {
      "type": "string",
      "required": false,
      "default": "cart:open"
    },
    "title": {
      "type": "string",
      "required": false,
      "default": "Shopping cart"
    },
    "width": {
      "type": "string",
      "required": false,
      "default": "var(--lx-cart-panel-width,440px)"
    },
    "maxHeight": {
      "type": "string",
      "required": false,
      "default": "85vh"
    },
    "overlay": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "animate": {
      "type": "union",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        }
      ],
      "required": false,
      "default": "smooth"
    },
    "swipeToDismiss": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "dragHandle": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "headerLayout": {
      "type": "enum",
      "values": [
        "single_row",
        "title_and_count"
      ],
      "required": false,
      "default": "title_and_count"
    },
    "countStyle": {
      "type": "enum",
      "values": [
        "inline",
        "secondary",
        "hidden"
      ],
      "required": false,
      "default": "secondary"
    },
    "closeStyle": {
      "type": "enum",
      "values": [
        "plain",
        "circle"
      ],
      "required": false,
      "default": "circle"
    },
    "stickyHeader": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "stickyFooter": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "contentBackground": {
      "type": "enum",
      "values": [
        "surface",
        "subtle"
      ],
      "required": false,
      "default": "surface"
    },
    "__innerHTML": {
      "type": "string",
      "required": false,
      "default": ""
    }
  },
  "variants": null,
  "css_vars": [
    "--lx-bg-color",
    "--lx-bg-surface",
    "--lx-border-color",
    "--lx-cart-panel-width",
    "--lx-surface-alt",
    "--lx-text-color",
    "--lx-text-muted"
  ],
  "parts": [
    "body",
    "close",
    "content",
    "drag-handle",
    "footer",
    "header",
    "header-count",
    "header-title",
    "overlay",
    "panel",
    "portal",
    "scroll-region"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    }
  }
}
