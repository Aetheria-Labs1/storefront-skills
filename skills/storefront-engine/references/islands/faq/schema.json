{
  "contract_version": 2,
  "name": "FAQ",
  "category": "content",
  "capabilities": [],
  "usage_hint": "Accessible FAQ/Accordion island with single-open or multiple-open behavior, initial state, keyboard navigation, reduced-motion support, configurable icons, and stable styling parts.",
  "when_to_use": "Use for product questions, shipping, returns, sizing, care, or policy disclosures that benefit from progressive disclosure.",
  "when_not_to_use": "Do not hide critical purchase terms that should remain visible. For one short answer, use normal HTML instead.",
  "defaultHydrate": "immediate",
  "combine_with": [
    "BuyBox",
    "ProductGallery",
    "ReviewList"
  ],
  "anti_patterns": [
    "Opening every long answer by default",
    "Putting interactive forms or nested accordions inside answers",
    "Using vague questions that do not help a purchase decision"
  ],
  "props": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "shape": {
          "id": "?string",
          "question": "string",
          "answer": "string",
          "initiallyOpen": "?boolean"
        }
      },
      "shape": {
        "id": "?string",
        "question": "string",
        "answer": "string",
        "initiallyOpen": "?boolean"
      },
      "required": true
    },
    "variant": {
      "type": "enum",
      "values": [
        "default",
        "compact"
      ],
      "required": false,
      "default": "default"
    },
    "mode": {
      "type": "enum",
      "values": [
        "single",
        "multiple"
      ],
      "required": false,
      "default": "single"
    },
    "initiallyOpen": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "required": false,
      "default": "[]"
    },
    "icon": {
      "type": "enum",
      "values": [
        "none",
        "plus",
        "chevron"
      ],
      "required": false,
      "default": "plus"
    }
  },
  "variants": [
    "default",
    "compact"
  ],
  "css_vars": [
    "--lx-accent-color",
    "--lx-text-color"
  ],
  "parts": [
    "answer",
    "content",
    "icon",
    "item",
    "question",
    "root",
    "summary"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    }
  }
}
