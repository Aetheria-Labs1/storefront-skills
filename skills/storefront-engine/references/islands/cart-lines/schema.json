{
  "contract_version": 2,
  "name": "CartLines",
  "category": "commerce",
  "capabilities": [],
  "usage_hint": "Renders cart line items with quantity controls and remove buttons. Subscribes to shared cart state.",
  "when_to_use": "Inside DrawerShell as the main cart items list. Shows each line with image, title, variant, price, and quantity +/- controls.",
  "when_not_to_use": "Outside a cart context. If you need a static product list, use ProductCarousel instead.",
  "defaultHydrate": "idle",
  "combine_with": [
    "DrawerShell",
    "CartSummary",
    "CartCheckoutButton",
    "CartProgressBar"
  ],
  "anti_patterns": [],
  "props": {
    "layout": {
      "type": "enum",
      "values": [
        "compact",
        "full"
      ],
      "required": false
    },
    "size": {
      "type": "enum",
      "values": [
        "sm",
        "md",
        "lg"
      ],
      "required": false
    },
    "imageAspect": {
      "type": "enum",
      "values": [
        "square",
        "portrait"
      ],
      "required": false
    },
    "dividers": {
      "type": "boolean",
      "required": false
    },
    "showQuantity": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "showRemove": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "showImage": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "emptyMessage": {
      "type": "string",
      "required": false,
      "default": "Your cart is empty"
    },
    "emptyCtaText": {
      "type": "string",
      "required": false,
      "default": "Continue Shopping"
    },
    "emptyCtaUrl": {
      "type": "string",
      "required": false,
      "default": "/"
    },
    "spacing": {
      "type": "enum",
      "values": [
        "compact",
        "comfortable",
        "spacious"
      ],
      "required": false
    },
    "quantityAnimation": {
      "type": "enum",
      "values": [
        "none",
        "slide",
        "crossfade",
        "roll"
      ],
      "required": false
    },
    "buttonFeedback": {
      "type": "enum",
      "values": [
        "none",
        "press",
        "highlight"
      ],
      "required": false
    },
    "itemRemovalAnimation": {
      "type": "enum",
      "values": [
        "none",
        "slide",
        "fade",
        "collapse"
      ],
      "required": false
    },
    "showPurchaseOptions": {
      "type": "boolean",
      "required": false
    },
    "purchaseOptionStyle": {
      "type": "enum",
      "values": [
        "cards",
        "select"
      ],
      "required": false
    },
    "purchaseOptionMessage": {
      "type": "string",
      "required": false
    },
    "quantityStyle": {
      "type": "enum",
      "values": [
        "select",
        "stepper",
        "split_buttons"
      ],
      "required": false,
      "default": "stepper"
    },
    "removeStyle": {
      "type": "enum",
      "values": [
        "icon",
        "text"
      ],
      "required": false,
      "default": "icon"
    },
    "salePriceStyle": {
      "type": "enum",
      "values": [
        "stacked",
        "inline"
      ],
      "required": false,
      "default": "inline"
    },
    "showDiscountPercent": {
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    "freeGift": {
      "type": "object",
      "shape": {
        "variant": "?'standard_line' | 'highlighted_line' | 'gift_card'",
        "badgeText": "?string",
        "icon": "?string",
        "showOriginalPrice": "?boolean",
        "lockQuantity": "?boolean"
      },
      "required": false
    }
  },
  "variants": [
    "compact",
    "full"
  ],
  "css_vars": [
    "--lx-accent-color",
    "--lx-bg-surface",
    "--lx-border-color",
    "--lx-cart-radius",
    "--lx-error-color",
    "--lx-gift-color",
    "--lx-reward-color",
    "--lx-surface-alt",
    "--lx-surface-color",
    "--lx-text-color",
    "--lx-text-muted"
  ],
  "parts": [
    "add-button",
    "empty",
    "empty-cta",
    "empty-message",
    "fallback",
    "free-gift-label",
    "heading",
    "item",
    "item-image",
    "item-image-wrap",
    "item-info",
    "item-price",
    "item-title",
    "item-variant",
    "line-group",
    "purchase-option",
    "qty-controls",
    "qty-decrease",
    "qty-increase",
    "qty-value",
    "remove-btn",
    "reward-badge",
    "reward-qty",
    "root"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    }
  }
}
