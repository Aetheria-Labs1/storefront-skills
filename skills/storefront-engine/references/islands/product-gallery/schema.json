{
  "contract_version": 2,
  "name": "ProductGallery",
  "category": "commerce",
  "usage_hint": "PDP media gallery with thumbnail rails, editorial photo grids, mixed image/video support, lightbox viewing, and variant synchronization.",
  "when_to_use": "Use on product detail pages for horizontal/vertical thumbnail galleries or CSS-customizable grid, collage, masonry, and stacked media layouts.",
  "when_not_to_use": "Not for hero banners (use ProductHero). Not for card media (use MediaCarousel). Not for standalone image carousels (use MediaSlideshow primitive).",
  "defaultHydrate": "immediate",
  "combine_with": [
    "BuyBox (product context)",
    "VariantSwatches (when listenForVariant:true",
    "gallery auto-updates images on variant change)"
  ],
  "anti_patterns": [
    "Setting listenForVariant:true without emitting variant:changed events: gallery won't update on variant selection",
    "Using a grid layout without a mobileLayout decision: verify the default swipe rail fits the surrounding PDP composition",
    "Setting autoplay with short interval: distracts users from reading product details",
    "Using kenBurns transition on every image: excessive motion, may trigger motion sensitivity"
  ],
  "props": {
    "media": {
      "type": "array",
      "required": false
    },
    "images": {
      "type": "array",
      "required": false,
      "shape": {
        "id": "?string",
        "type": "?'image' | 'video'",
        "src": "?string",
        "url": "?string",
        "alt": "?string",
        "poster": "?string",
        "mobileSrc": "?string",
        "srcSet": "?string",
        "srcSetWebp": "?string",
        "sizes": "?string",
        "fit": "?'cover' | 'contain'",
        "objectFit": "?'cover' | 'contain'",
        "objectPosition": "?string",
        "sources": "?array<{type: ?'application/x-mpegURL' | 'application/vnd.apple.mpegurl' | 'application/dash+xml' | 'video/mp4' | 'video/webm' | 'video/ogg', url: string, width: ?number, height: ?number, bitrate: ?number}>",
        "preview": "?{url: string, type: 'video/mp4' | 'image/gif' | 'image/webp', poster: ?string}",
        "captionsUrl": "?string",
        "assetId": "?string",
        "provider": "?'cloudflare_stream' | 'cloudflare_cdn' | 'external'"
      }
    },
    "layout": {
      "type": "enum",
      "required": false,
      "values": [
        "horizontal",
        "vertical",
        "stacked",
        "grid",
        "collageLeft",
        "collageRight",
        "twoColumn",
        "masonry"
      ],
      "default": "horizontal"
    },
    "mobileLayout": {
      "type": "enum",
      "required": false,
      "values": [
        "stacked",
        "swipe"
      ]
    },
    "enableLightbox": {
      "type": "boolean",
      "required": false
    },
    "autoplay": {
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    "interval": {
      "type": "number",
      "required": false,
      "default": "4000"
    },
    "transition": {
      "type": "enum",
      "required": false,
      "values": [
        "none",
        "slide",
        "fade",
        "zoom",
        "kenBurns"
      ],
      "default": "fade"
    },
    "listenForVariant": {
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    "maxHeight": {
      "type": "string",
      "required": false
    },
    "thumbPosition": {
      "type": "enum",
      "required": false,
      "values": [
        "left",
        "right",
        "bottom",
        "top"
      ]
    },
    "objectFit": {
      "type": "enum",
      "required": false,
      "values": [
        "cover",
        "contain"
      ],
      "default": "cover"
    }
  },
  "variants": [
    "horizontal",
    "vertical",
    "stacked",
    "grid",
    "collageLeft",
    "collageRight",
    "twoColumn",
    "masonry"
  ],
  "css_vars": [
