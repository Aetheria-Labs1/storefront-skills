{
  "contract_version": 2,
  "name": "ShoppableVideoFeed",
  "category": "commerce",
  "capabilities": [
    {
      "name": "product:resolve"
    },
    {
      "name": "cart:add"
    },
    {
      "name": "cart:open"
    },
    {
      "name": "media:carousel"
    }
  ],
  "usage_hint": "Shoppable short-form video sequence with reel, rail, and poster-grid presentations.",
  "when_to_use": "Use for UGC, creator demonstrations, testimonials, and product videos with tagged Shopify products.",
  "when_not_to_use": "Use VideoPlayer for one non-shoppable video and ProductGallery for product-media thumbnails.",
  "defaultHydrate": "immediate",
  "combine_with": [
    "DrawerShell",
    "CartLines",
    "CartSummary",
    "CartCheckoutButton"
  ],
  "anti_patterns": [
    "Omitting poster images, which creates blank loading surfaces and layout instability",
    "Constructing Cloudflare playback URLs in the browser instead of supplying explicit public source URLs",
    "Enabling unmuted autoplay, which browsers block and shoppers do not expect"
  ],
  "props": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "shape": {
          "id": "string",
          "media": "?{assetId: ?object, provider: ?object, sources: object, poster: object, preview: ?object, captionsUrl: ?object}",
          "src": "?string",
          "poster": "?string",
          "captionsSrc": "?string",
          "alt": "string",
          "title": "?string",
          "caption": "?string",
          "badge": "?string",
          "creator": "?{name: object, handle: ?object, avatar: ?object, verified: ?object}",
          "metrics": "?{views: ?object, likes: ?object, comments: ?object}",
          "testimonial": "?{author: object, productLabel: ?object, rating: ?object, verified: ?object}",
          "products": "array<{productId: string, variantId: ?object, label: ?object, ctaLabel: ?object, title: ?object, price: ?object, compareAtPrice: ?object, image: ?object, available: ?object | object, productUrl: ?object, variants: ?object}>"
        }
      },
      "shape": {
        "id": "string",
        "media": "?{assetId: ?object, provider: ?'cloudflare_stream' | 'cloudflare_cdn' | 'external', sources: array<{}>, poster: string, preview: ?object, captionsUrl: ?object}",
        "src": "?string",
        "poster": "?string",
        "captionsSrc": "?string",
        "alt": "string",
        "title": "?string",
        "caption": "?string",
        "badge": "?string",
        "creator": "?{name: string, handle: ?object, avatar: ?object, verified: ?object | object}",
        "metrics": "?{views: ?object, likes: ?object, comments: ?object}",
        "testimonial": "?{author: string, productLabel: ?object, rating: ?object, verified: ?object | object}",
        "products": "array<{productId: string, variantId: ?string, label: ?string, ctaLabel: ?string, title: ?string, price: ?string, compareAtPrice: ?string, image: ?string, available: ?boolean | boolean, productUrl: ?string, variants: ?array<{}>}>"
      },
      "required": true
    },
    "variant": {
      "type": "enum",
      "values": [
        "grid",
        "rail",
        "reel"
      ],
      "required": false
    },
    "reelMode": {
      "type": "enum",
      "values": [
        "paged",
        "vertical-scroll"
      ],
      "required": false
    },
    "railPresentation": {
      "type": "enum",
      "values": [
        "standard",
        "coverflow"
      ],
      "required": false
    },
    "viewerMode": {
      "type": "enum",
      "values": [
        "inline",
        "fullscreen"
      ],
      "required": false
    },
    "aspectRatio": {
      "type": "enum",
      "values": [
        "9:16",
        "4:5",
        "1:1"
      ],
      "required": false
    },
    "actionMode": {
      "type": "enum",
      "values": [
        "add_to_cart",
        "buy_now",
        "view_product"
      ],
      "required": false
    },
    "productPresentation": {
      "type": "enum",
      "values": [
        "card",
        "auto",
        "button",
        "hidden",
        "chip"
      ],
      "required": false
    },
    "openCartOnAdd": {
      "type": "boolean",
      "required": false
    },
    "showProductImage": {
      "type": "boolean",
      "required": false
    },
    "showProductPrice": {
      "type": "boolean",
      "required": false
    },
    "playbackMode": {
      "type": "enum",
      "values": [
        "hover",
        "manual",
        "active",
        "always-visible"
      ],
      "required": false
    },
    "soundMode": {
      "type": "enum",
      "values": [
        "hover",
        "muted",
        "toggle"
      ],
      "required": false
    },
    "controlsVisibility": {
      "type": "enum",
      "values": [
        "hover",
        "never",
        "always"
      ],
      "required": false
    },
    "navigationMode": {
      "type": "enum",
      "values": [
        "none",
        "swipe",
        "buttons",
        "both"
      ],
      "required": false
    },
    "mobileNavigationMode": {
      "type": "enum",
      "values": [
        "none",
        "swipe",
        "buttons",
        "both"
      ],
      "required": false
    },
    "navigationPlacement": {
      "type": "enum",
      "values": [
        "below",
        "overlay"
      ],
      "required": false
    },
    "autoAdvance": {
      "type": "boolean",
      "required": false
    },
    "autoAdvanceIntervalMs": {
      "type": "number",
      "required": false
    },
    "pauseAutoAdvanceOnHover": {
      "type": "boolean",
      "required": false
    },
    "pauseAutoAdvanceOnFocus": {
      "type": "boolean",
      "required": false
    },
    "resumeAutoAdvanceAfterMs": {
      "type": "number",
      "required": false
    },
    "previewMode": {
      "type": "enum",
      "values": [
        "hover",
        "always",
        "poster"
      ],
      "required": false
    },
    "loop": {
      "type": "boolean",
      "required": false
    },
    "showProgress": {
      "type": "boolean",
      "required": false
    },
    "pauseWhenHidden": {
      "type": "boolean",
      "required": false
    },
    "preload": {
      "type": "enum",
      "values": [
        "none",
        "auto",
        "metadata"
      ],
      "required": false
    },
    "preloadAdjacent": {
      "type": "boolean",
      "required": false
    },
    "heading": {
      "type": "string",
      "required": false
    },
    "showCreator": {
      "type": "boolean",
      "required": false
    },
    "showCaption": {
      "type": "boolean",
      "required": false
    },
    "showMetrics": {
      "type": "boolean",
      "required": false
    },
    "showBadge": {
      "type": "boolean",
      "required": false
    },
    "showTestimonial": {
      "type": "boolean",
      "required": false
    },
    "initialIndex": {
      "type": "number",
      "required": false
    },
    "showCounter": {
      "type": "boolean",
      "required": false
    },
    "columns": {
      "type": "number",
      "required": false
    },
    "maxVisibleItems": {
      "type": "number",
      "required": false
    },
    "autoplay": {
      "type": "boolean",
      "required": false,
      "deprecated": true,
      "description": "Use playbackMode."
    },
    "muted": {
      "type": "boolean",
      "required": false,
      "deprecated": true,
      "description": "Use soundMode."
    },
    "showControls": {
      "type": "boolean",
      "required": false,
      "deprecated": true,
      "description": "Use controlsVisibility."
    },
    "showNavigation": {
      "type": "boolean",
      "required": false,
      "deprecated": true,
      "description": "Use navigationMode and mobileNavigationMode."
    }
  },
  "variants": [
    "grid",
    "rail",
    "reel"
  ],
