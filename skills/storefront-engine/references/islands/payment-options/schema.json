{
  "contract_version": 2,
  "name": "PaymentOptions",
  "category": "commerce",
  "capabilities": [],
  "usage_hint": "Buy-now-pay-later badge showing installment pricing for Klarna, Afterpay, Shop Pay, Affirm, Zip. Auto-calculates per-installment amount.",
  "when_to_use": "On product pages to show financing options. Listens for variant:changed events to update pricing. Three variants: inline (text + icons), expandable (click to show providers), icons_only (logo row).",
  "when_not_to_use": "When BNPL providers aren't enabled in your store. For subscription pricing use SubscriptionToggle. When product price is below provider minimums (usually $35-50).",
  "defaultHydrate": "immediate",
  "combine_with": [
    "ProductPrice",
    "BuyBox",
    "VariantSelector",
    "ProceedToCart"
  ],
  "anti_patterns": [
    "Listing providers that aren't actually enabled at checkout (misleading, causes cart abandonment)",
    "Using inline variant with >3 providers (too crowded — use expandable)",
    "Setting installments to anything other than 4 (most BNPL = 4 equal payments)"
  ],
  "props": {
    "visual": {
      "type": "union",
      "anyOf": [
        {
          "type": "object",
          "shape": {
            "kind": "string",
            "name": "'check' | 'alert-circle' | 'arrow-down' | 'arrow-left' | 'arrow-right' | 'arrow-up' | 'award' | 'camera' | 'cart' | 'check-circle' | 'chevron-down' | 'chevron-left' | 'chevron-right' | 'chevron-up' | 'clock' | 'credit-card' | 'download' | 'droplet' | 'external' | 'eye' | 'filter' | 'flame' | 'gift' | 'globe' | 'heart' | 'image' | 'info' | 'leaf' | 'lock' | 'mail' | 'menu' | 'minus' | 'moon' | 'package' | 'pause' | 'percent' | 'phone' | 'play' | 'plus' | 'refresh' | 'search' | 'share' | 'shield' | 'shield-check' | 'sparkles' | 'star' | 'star-outline' | 'sun' | 'tag' | 'thumbs-up' | 'trash' | 'truck' | 'user' | 'volume' | 'x' | 'zap'",
            "fallbackIcon": "?'check' | 'alert-circle' | 'arrow-down' | 'arrow-left' | 'arrow-right' | 'arrow-up' | 'award' | 'camera' | 'cart' | 'check-circle' | 'chevron-down' | 'chevron-left' | 'chevron-right' | 'chevron-up' | 'clock' | 'credit-card' | 'download' | 'droplet' | 'external' | 'eye' | 'filter' | 'flame' | 'gift' | 'globe' | 'heart' | 'image' | 'info' | 'leaf' | 'lock' | 'mail' | 'menu' | 'minus' | 'moon' | 'package' | 'pause' | 'percent' | 'phone' | 'play' | 'plus' | 'refresh' | 'search' | 'share' | 'shield' | 'shield-check' | 'sparkles' | 'star' | 'star-outline' | 'sun' | 'tag' | 'thumbs-up' | 'trash' | 'truck' | 'user' | 'volume' | 'x' | 'zap'"
          }
        },
        {
          "type": "object",
          "shape": {
            "kind": "'asset_svg' | 'asset_image'",
            "assetId": "string",
            "url": "string",
            "srcSet": "?string",
            "altText": "?string",
            "width": "?unknown | number",
            "height": "?unknown | number",
            "fit": "?'contain' | 'cover'",
            "fallbackIcon": "'check' | 'alert-circle' | 'arrow-down' | 'arrow-left' | 'arrow-right' | 'arrow-up' | 'award' | 'camera' | 'cart' | 'check-circle' | 'chevron-down' | 'chevron-left' | 'chevron-right' | 'chevron-up' | 'clock' | 'credit-card' | 'download' | 'droplet' | 'external' | 'eye' | 'filter' | 'flame' | 'gift' | 'globe' | 'heart' | 'image' | 'info' | 'leaf' | 'lock' | 'mail' | 'menu' | 'minus' | 'moon' | 'package' | 'pause' | 'percent' | 'phone' | 'play' | 'plus' | 'refresh' | 'search' | 'share' | 'shield' | 'shield-check' | 'sparkles' | 'star' | 'star-outline' | 'sun' | 'tag' | 'thumbs-up' | 'trash' | 'truck' | 'user' | 'volume' | 'x' | 'zap'"
          }
        }
      ],
      "required": false
    },
    "price": {
      "type": "number",
      "required": true
    },
    "currency": {
      "type": "string",
      "required": false,
      "default": "USD"
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "enum",
        "values": [
          "visa",
          "mastercard",
          "amex",
          "discover",
          "diners",
          "jcb",
          "paypal",
          "apple_pay",
          "google_pay",
          "shop_pay",
          "klarna",
          "afterpay",
          "affirm",
          "stripe",
          "cashapp",
          "upi",
          "phonepe",
          "razorpay",
          "paytm",
          "zip"
        ]
      },
      "required": false,
      "default": "[\"klarna\", \"afterpay\", \"shop_pay\"]"
    },
    "installments": {
      "type": "number",
      "required": false,
      "default": "4"
    },
    "variant": {
      "type": "enum",
      "values": [
        "icons_only",
        "icons_with_labels",
        "inline",
        "expandable"
      ],
      "required": false,
      "default": "inline"
    },
    "alignment": {
      "type": "enum",
      "values": [
        "left",
        "center"
      ],
      "required": false,
      "default": "center"
    },
    "listenForEvents": {
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    "hideWhenCartEmpty": {
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    "padded": {
      "type": "boolean",
      "required": false,
      "default": "false"
    }
  },
  "variants": [
    "icons_only",
    "icons_with_labels",
    "inline",
    "expandable"
  ],
  "css_vars": [
    "--lx-text-color",
    "--lx-text-muted"
  ],
  "parts": [
    "button",
    "icons-row",
    "provider",
    "provider-fallback",
    "provider-logo",
    "root",
    "text"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    }
  }
}
