{
  "contract_version": 2,
  "name": "PaymentOptions",
  "category": "commerce",
  "capabilities": [],
  "usage_hint": "Buy-now-pay-later badge showing installment pricing for Klarna, Afterpay, Shop Pay, Affirm, Zip. Auto-calculates per-installment amount.",
  "when_to_use": "On product pages to show financing options. Listens for variant:changed events to update pricing. Three variants: inline (text + icons), expandable (click to show providers), icons_only (logo row).",
  "when_not_to_use": "When BNPL providers aren't enabled in your store. For subscription pricing use SubscriptionToggle. When product price is below provider minimums (usually $35-50).",
  "defaultHydrate": "immediate",
  "combine_with": [
    "ProductPrice",
    "BuyBox",
    "VariantSelector",
    "ProceedToCart"
  ],
  "anti_patterns": [
    "Listing providers that aren't actually enabled at checkout (misleading, causes cart abandonment)",
    "Using inline variant with >3 providers (too crowded \u2014 use expandable)",
    "Setting installments to anything other than 4 (most BNPL = 4 equal payments)"
  ],
  "props": {
    "price": {
      "type": "number",
      "required": true
    },
    "currency": {
      "type": "string",
      "required": false,
      "default": "USD"
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "enum",
        "values": [
          "visa",
          "mastercard",
          "amex",
          "discover",
          "diners",
          "jcb",
          "paypal",
          "apple_pay",
          "google_pay",
          "shop_pay",
          "klarna",
          "afterpay",
          "affirm",
          "stripe",
          "cashapp",
          "upi",
          "zip"
        ]
      },
      "required": false,
      "default": "[\"klarna\", \"afterpay\", \"shop_pay\"]"
    },
    "installments": {
      "type": "number",
      "required": false,
      "default": "4"
    },
    "variant": {
      "type": "enum",
      "values": [
        "inline",
        "expandable",
        "icons_only"
      ],
      "required": false,
      "default": "inline"
    },
    "listenForEvents": {
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    "hideWhenCartEmpty": {
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    "padded": {
      "type": "boolean",
      "required": false,
      "default": "false"
    }
  },
  "variants": [
    "inline",
    "expandable",
    "icons_only"
  ],
  "css_vars": [
    "--lx-text-color"
  ],
  "parts": [
    "button",
    "icons-row",
    "provider-fallback",
    "provider-logo",
    "root",
    "text"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    }
  }
}
