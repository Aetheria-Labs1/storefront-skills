{
  "contract_version": 2,
  "name": "CartCrossSell",
  "category": "commerce",
  "capabilities": [
    {
      "name": "product:resolve"
    },
    {
      "name": "cart:add"
    },
    {
      "name": "cart:open"
    }
  ],
  "usage_hint": "Self-contained cross-sell/upsell inside the cart drawer. Reads config from $cartConfig.upsells, evaluates triggers against $cartLines, fetches recommended products, and self-hides when no triggers match. No external rules needed.",
  "when_to_use": "Inside DrawerShell to show product recommendations based on cart contents. Config comes from commerce_config.upsells — the island is fully reactive to cart state changes.",
  "when_not_to_use": "Outside cart context. For static product grids use ProductCarousel.",
  "defaultHydrate": "immediate",
  "combine_with": [
    "DrawerShell",
    "CartLines",
    "CartSummary",
    "CartCheckoutButton",
    "CartProgressBar"
  ],
  "anti_patterns": [
    "Passing product data via data-props (use commerce_config.upsells instead — the island reads from $cartConfig)",
    "Using hidden class + rules for visibility (the island self-manages show/hide)",
    "Placing outside DrawerShell (needs cart state subscription)"
  ],
  "props": {
    "visual": {
      "type": "union",
      "anyOf": [
        {
          "type": "object",
          "shape": {
            "kind": "string",
            "name": "'check' | 'alert-circle' | 'arrow-down' | 'arrow-left' | 'arrow-right' | 'arrow-up' | 'award' | 'camera' | 'cart' | 'check-circle' | 'chevron-down' | 'chevron-left' | 'chevron-right' | 'chevron-up' | 'clock' | 'credit-card' | 'download' | 'droplet' | 'external' | 'eye' | 'filter' | 'flame' | 'gift' | 'globe' | 'heart' | 'image' | 'info' | 'leaf' | 'lock' | 'mail' | 'menu' | 'minus' | 'moon' | 'package' | 'pause' | 'percent' | 'phone' | 'play' | 'plus' | 'refresh' | 'search' | 'share' | 'shield' | 'shield-check' | 'sparkles' | 'star' | 'star-outline' | 'sun' | 'tag' | 'thumbs-up' | 'trash' | 'truck' | 'user' | 'volume' | 'x' | 'zap'",
            "fallbackIcon": "?'check' | 'alert-circle' | 'arrow-down' | 'arrow-left' | 'arrow-right' | 'arrow-up' | 'award' | 'camera' | 'cart' | 'check-circle' | 'chevron-down' | 'chevron-left' | 'chevron-right' | 'chevron-up' | 'clock' | 'credit-card' | 'download' | 'droplet' | 'external' | 'eye' | 'filter' | 'flame' | 'gift' | 'globe' | 'heart' | 'image' | 'info' | 'leaf' | 'lock' | 'mail' | 'menu' | 'minus' | 'moon' | 'package' | 'pause' | 'percent' | 'phone' | 'play' | 'plus' | 'refresh' | 'search' | 'share' | 'shield' | 'shield-check' | 'sparkles' | 'star' | 'star-outline' | 'sun' | 'tag' | 'thumbs-up' | 'trash' | 'truck' | 'user' | 'volume' | 'x' | 'zap'"
          }
        },
        {
          "type": "object",
          "shape": {
            "kind": "'asset_svg' | 'asset_image'",
            "assetId": "string",
            "url": "string",
            "srcSet": "?string",
            "altText": "?string",
            "width": "?unknown | number",
            "height": "?unknown | number",
            "fit": "?'contain' | 'cover'",
            "fallbackIcon": "'check' | 'alert-circle' | 'arrow-down' | 'arrow-left' | 'arrow-right' | 'arrow-up' | 'award' | 'camera' | 'cart' | 'check-circle' | 'chevron-down' | 'chevron-left' | 'chevron-right' | 'chevron-up' | 'clock' | 'credit-card' | 'download' | 'droplet' | 'external' | 'eye' | 'filter' | 'flame' | 'gift' | 'globe' | 'heart' | 'image' | 'info' | 'leaf' | 'lock' | 'mail' | 'menu' | 'minus' | 'moon' | 'package' | 'pause' | 'percent' | 'phone' | 'play' | 'plus' | 'refresh' | 'search' | 'share' | 'shield' | 'shield-check' | 'sparkles' | 'star' | 'star-outline' | 'sun' | 'tag' | 'thumbs-up' | 'trash' | 'truck' | 'user' | 'volume' | 'x' | 'zap'"
          }
        }
      ],
      "required": false
    },
    "heading": {
      "type": "string",
      "required": false
    },
    "max": {
      "type": "number",
      "required": false
    },
    "layout": {
      "type": "enum",
      "values": [
        "horizontal",
        "grid",
        "stack"
      ],
      "required": false
    },
    "size": {
      "type": "enum",
      "values": [
        "sm",
        "md",
        "lg"
      ],
      "required": false
    },
    "imageAspect": {
      "type": "enum",
      "values": [
        "square",
        "portrait"
      ],
      "required": false
    },
    "density": {
      "type": "enum",
      "values": [
        "compact",
        "comfortable",
        "spacious"
      ],
      "required": false
    },
    "showPrice": {
      "type": "boolean",
      "required": false
    },
    "showQuickAdd": {
      "type": "boolean",
      "required": false
    },
    "buttonLabel": {
      "type": "string",
      "required": false
    },
    "placement": {
      "type": "enum",
      "values": [
        "header",
        "after_line",
        "after_lines",
        "before_checkout"
      ],
      "required": false,
      "default": "after_lines"
    },
    "slotId": {
      "type": "string",
      "required": false
    },
    "lineId": {
      "type": "string",
      "required": false
    },
    "embedded": {
      "type": "boolean",
      "required": false,
      "default": "false"
    }
  },
  "variants": [
    "horizontal",
    "grid",
    "stack"
  ],
  "css_vars": [
    "--lx-accent-color",
    "--lx-accent-contrast",
    "--lx-bg-color",
    "--lx-bg-surface",
    "--lx-border-color",
    "--lx-cart-body-size",
    "--lx-cart-control-radius",
    "--lx-cart-font-family",
    "--lx-cart-font-weight",
    "--lx-cart-title-size",
    "--lx-error-color",
    "--lx-focus-color",
    "--lx-font-body",
    "--lx-font-heading",
    "--lx-muted-color",
    "--lx-quick-add-backdrop",
    "--lx-quick-add-bg",
    "--lx-quick-add-button-radius",
    "--lx-quick-add-drawer-width",
    "--lx-quick-add-option-radius",
    "--lx-quick-add-shadow",
    "--lx-quick-add-sheet-height",
    "--lx-quick-add-z-index",
    "--lx-surface-alt",
    "--lx-surface-color",
    "--lx-text-color",
    "--lx-text-muted"
  ],
  "parts": [
    "add-button",
    "fallback",
    "heading",
    "item",
    "item-image",
    "item-info",
    "item-price",
    "item-title",
    "quick-add-backdrop",
    "quick-add-body",
    "quick-add-close",
    "quick-add-drag-handle",
    "quick-add-eyebrow",
    "quick-add-footer",
    "quick-add-header",
    "quick-add-image",
    "quick-add-option",
    "quick-add-option-group",
    "quick-add-option-label",
    "quick-add-option-values",
    "quick-add-options",
    "quick-add-panel",
    "quick-add-price",
    "quick-add-product",
    "quick-add-product-copy",
    "quick-add-product-title",
    "quick-add-purchase-options",
    "quick-add-selected-variant",
    "quick-add-sheet",
    "quick-add-status",
    "quick-add-submit",
    "quick-add-title",
    "quick-add-variant",
    "quick-add-variant-list",
    "root"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    }
  }
}
