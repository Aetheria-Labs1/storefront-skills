{
  "contract_version": 2,
  "name": "CartCrossSell",
  "category": "commerce",
  "capabilities": [
    {
      "name": "product:resolve"
    },
    {
      "name": "cart:add"
    },
    {
      "name": "cart:open"
    }
  ],
  "usage_hint": "Self-contained cross-sell/upsell inside the cart drawer. Reads config from $cartConfig.upsells, evaluates triggers against $cartLines, fetches recommended products, and self-hides when no triggers match. No external rules needed.",
  "when_to_use": "Inside DrawerShell to show product recommendations based on cart contents. Config comes from commerce_config.upsells — the island is fully reactive to cart state changes.",
  "when_not_to_use": "Outside cart context. For static product grids use ProductCarousel.",
  "defaultHydrate": "immediate",
  "combine_with": [
    "DrawerShell",
    "CartLines",
    "CartSummary",
    "CartCheckoutButton",
    "CartProgressBar"
  ],
  "anti_patterns": [
    "Passing product data via data-props (use commerce_config.upsells instead — the island reads from $cartConfig)",
    "Using hidden class + rules for visibility (the island self-manages show/hide)",
    "Placing outside DrawerShell (needs cart state subscription)"
  ],
  "props": {
    "heading": {
      "type": "string",
      "required": false
    },
    "max": {
      "type": "number",
      "required": false
    },
    "layout": {
      "type": "enum",
      "values": [
        "horizontal",
        "grid",
        "stack"
      ],
      "required": false
    },
    "size": {
      "type": "enum",
      "values": [
        "sm",
        "md",
        "lg"
      ],
      "required": false
    },
    "imageAspect": {
      "type": "enum",
      "values": [
        "square",
        "portrait"
      ],
      "required": false
    },
    "density": {
      "type": "enum",
      "values": [
        "compact",
        "comfortable",
        "spacious"
      ],
      "required": false
    },
    "showPrice": {
      "type": "boolean",
      "required": false
    },
    "showQuickAdd": {
      "type": "boolean",
      "required": false
    },
    "buttonLabel": {
      "type": "string",
      "required": false
    },
    "placement": {
      "type": "enum",
      "values": [
        "header",
        "after_line",
        "after_lines",
        "before_checkout"
      ],
      "required": false,
      "default": "after_lines"
    },
    "slotId": {
      "type": "string",
      "required": false
    },
    "lineId": {
      "type": "string",
      "required": false
    },
    "embedded": {
      "type": "boolean",
      "required": false,
      "default": "false"
    }
  },
  "variants": [
    "horizontal",
    "grid",
    "stack"
  ],
  "css_vars": [
    "--lx-accent-color",
    "--lx-border-color",
    "--lx-surface-alt",
    "--lx-surface-color",
    "--lx-text-color"
  ],
  "parts": [
    "add-button",
    "heading",
    "item",
    "item-image",
    "item-info",
    "item-price",
    "item-title",
    "root"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    }
  }
}
