{
  "contract_version": 2,
  "name": "BundleBuilder",
  "category": "commerce",
  "capabilities": [
    {
      "name": "cart:add"
    },
    {
      "name": "cart:open"
    }
  ],
  "usage_hint": "Multi-product bundle or peer-set selector with optional discount and \"Add All to Cart\" action.",
  "when_to_use": "Use on PDP or collection pages for complementary bundles, gift sets, kits, and peer-product sets.",
  "when_not_to_use": "Not for single-product add-to-cart (use BuyBox or QuickAdd). Not for general product grids (use ProductCarousel). Not for cross-sells without bundle context (use ProductCarousel).",
  "defaultHydrate": "immediate",
  "combine_with": [
    "Cart V2 via head.use_cart_v2",
    "BuyBox (common on PDP pages)"
  ],
  "anti_patterns": [
    "Omitting CartDrawer: users get no cart confirmation feedback after clicking \"Add All\"",
    "Using without a discount: reduces incentive; bundle builders work best with visible savings",
    "Mixing incompatible products: bundle should make logical sense (e.g., phone + case + charger, not random items)",
    "Using layout:\"stacked\" with 5+ recommendations: becomes very tall; use horizontal layout or limit items"
  ],
  "props": {
    "mainProduct": {
      "type": "object",
      "shape": {
        "id": "string",
        "title": "string",
        "price": "string | {amount: object | object, currency_code: string}",
        "image": "string",
        "handle": "?string",
        "selected": "?boolean | boolean"
      },
      "required": false
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "shape": {
          "id": "string",
          "title": "string",
          "price": "string | {amount: object, currency_code: object}",
          "image": "string",
          "handle": "?string",
          "selected": "?boolean | boolean"
        }
      },
      "shape": {
        "id": "string",
        "title": "string",
        "price": "string | {amount: object | object, currency_code: string}",
        "image": "string",
        "handle": "?string",
        "selected": "?boolean | boolean"
      },
      "required": false,
      "default": "[]"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "shape": {
          "id": "string",
          "title": "string",
          "price": "string | {amount: object, currency_code: object}",
          "image": "string",
          "handle": "?string",
          "selected": "?boolean | boolean"
        }
      },
      "shape": {
        "id": "string",
        "title": "string",
        "price": "string | {amount: object | object, currency_code: string}",
        "image": "string",
        "handle": "?string",
        "selected": "?boolean | boolean"
      },
      "required": false
    },
    "bundleDiscount": {
      "type": "object",
      "shape": {
        "type": "'percentage' | 'fixed'",
        "value": "number"
      },
      "required": false
    },
    "title": {
      "type": "string",
      "required": false,
      "default": "Frequently bought together"
    },
    "layout": {
      "type": "enum",
      "values": [
        "horizontal",
        "stacked"
      ],
      "required": false,
      "default": "horizontal"
    },
    "showCheckboxes": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "currencyCode": {
      "type": "string",
      "required": false
    },
    "locale": {
      "type": "string",
      "required": false
    }
  },
  "variants": [
    "horizontal",
    "stacked"
  ],
  "css_vars": [
    "--lx-accent-color",
    "--lx-text-color"
  ],
  "parts": [
    "cta",
    "heading",
    "item",
    "item-checkbox",
    "item-image",
    "item-price",
    "item-title",
    "main-image",
    "main-price",
    "main-product",
    "main-title",
    "pricing",
    "root",
    "savings-badge",
    "subtotal",
    "total"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    }
  }
}
