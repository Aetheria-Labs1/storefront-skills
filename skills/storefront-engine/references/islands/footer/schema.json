{
  "contract_version": 2,
  "name": "Footer",
  "category": "navigation",
  "capabilities": [],
  "usage_hint": "Site-wide footer with links, logo, newsletter signup, social icons, and copyright. Always placed at bottom of page.",
  "when_to_use": "Every page needs a footer. Supports multiple layouts (simple, columns, centered, editorialGrid, newsletterSplit) and both hydration mode (custom HTML with data-lx-footer tags) and legacy mode (React-rendered). Hydration mode's newsletter form captures automatically \u2014 no endpoint to configure.",
  "when_not_to_use": "For minimal page templates without site-wide footer (rare). For mid-page newsletter blocks use a dedicated newsletter island.",
  "defaultHydrate": "immediate",
  "combine_with": [
    "Navbar",
    "SiteHeader",
    "native top anchor"
  ],
  "anti_patterns": [
    "Using multiple Footer instances on one page \u2014 there should be one site-wide footer",
    "Hardcoding current year instead of using data-lx-footer=\"year\" (hydration) or letting the component auto-fill it",
    "Duplicating social links in both Footer and separate social bar (pick one location)"
  ],
  "props": {
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "shape": {
          "label": "string",
          "url": "string"
        }
      },
      "shape": {
        "label": "string",
        "url": "string"
      },
      "required": false
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "shape": {
          "heading": "?string",
          "links": "array<{label: string, url: string}>"
        }
      },
      "shape": {
        "heading": "?string",
        "links": "array<{label: string, url: string}>"
      },
      "required": false
    },
    "logo": {
      "type": "object",
      "shape": {
        "src": "string",
        "alt": "?string"
      },
      "required": false
    },
    "copyright": {
      "type": "string",
      "required": false
    },
    "tagline": {
      "type": "string",
      "required": false
    },
    "socialLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "shape": {
          "platform": "string",
          "url": "string",
          "icon": "?string"
        }
      },
      "shape": {
        "platform": "string",
        "url": "string",
        "icon": "?string"
      },
      "required": false
    },
    "style": {
      "type": "object",
      "shape": {
        "bgColor": "?string",
        "textColor": "?string",
        "linkColor": "?string",
        "linkHoverColor": "?string",
        "headingColor": "?string",
        "accentColor": "?string",
        "borderColor": "?string",
        "fontFamily": "?string",
        "fontSize": "?string",
        "padding": "?string",
        "maxWidth": "?string",
        "logoHeight": "?string",
        "logoFilter": "?string",
        "layout": "?'simple' | 'centered' | 'columns' | 'editorialGrid' | 'newsletterSplit'"
      },
      "required": false
    },
    "newsletter": {
      "type": "object",
      "shape": {
        "heading": "?string",
        "placeholder": "?string",
        "buttonText": "?string"
      },
      "required": false
    },
    "borderStyle": {
      "type": "enum",
      "values": [
        "none",
        "solid",
        "dashed"
      ],
      "required": false
    },
    "tileLayout": {
      "type": "boolean",
      "required": false
    },
    "successMessage": {
      "type": "string",
      "required": false
    }
  },
  "variants": [
    "none",
    "solid",
    "dashed"
  ],
  "css_vars": [
    "--lx-accent-color"
  ],
  "parts": [
    "columns",
    "nav-rows",
    "newsletter",
    "root",
    "social-tiles"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    }
  }
}
