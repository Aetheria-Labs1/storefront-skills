{
  "contract_version": 2,
  "name": "CollectionGrid",
  "category": "commerce",
  "capabilities": [
    {
      "name": "cart:add",
      "when": {
        "prop": "quickAdd.enabled",
        "notEquals": false
      }
    },
    {
      "name": "cart:open",
      "when": {
        "prop": "quickAdd.enabled",
        "notEquals": false
      }
    }
  ],
  "usage_hint": "Live Shopify collection grid. Loads the collection by handle from the Storefront API with filters, sort, load-more and Quick Add per card; filter, sort and page state live in the URL using Shopify theme parameter names.",
  "when_to_use": "Use for collection and category pages, and any edit with more than about 24 products, so every product in the collection is reachable with live price and stock.",
  "when_not_to_use": "Not for a short hand-picked rail (use ProductCarousel or FeaturedCollectionStage) or a single product (use BuyBox).",
  "defaultHydrate": "visible",
  "combine_with": [
    "Navbar",
    "AnnouncementBar",
    "the renderer-managed effective Cart V2 profile"
  ],
  "anti_patterns": [
    "Typing product cards by hand for a collection this island can load: prices and stock go stale",
    "Card templates without an lx-slot named quick-add while quickAdd is on: the compiler rejects them",
    "Restyling cards with hover scale or translate: use the card parts and colour or shadow changes"
  ],
  "props": {
    "collection": {
      "type": "string",
      "required": false
    },
    "pageSize": {
      "type": "number",
      "required": false,
      "default": "24"
    },
    "initialSort": {
      "type": "enum",
      "values": [
        "manual",
        "best-selling",
        "title-ascending",
        "title-descending",
        "price-ascending",
        "price-descending",
        "created-ascending",
        "created-descending"
      ],
      "required": false,
      "default": "manual"
    },
    "columns": {
      "type": "object",
      "shape": {
        "mobile": "?number",
        "tablet": "?number",
        "desktop": "?number"
      },
      "required": false
    },
    "aspectRatio": {
      "type": "string",
      "required": false,
      "default": "4 / 5"
    },
    "showCompareAt": {
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    "hoverSecondImage": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "quickAdd": {
      "type": "union",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "shape": {
            "enabled": "?boolean",
            "placement": "?'media-top-right' | 'details-after' | 'custom'",
            "label": "?string",
            "triggerContent": "?string",
            "openCartOnAdd": "?boolean",
            "picker": "?{desktop: ?'drawer-right' | 'bottom-sheet', mobile: ?'bottom-sheet', title: ?string, closeOnAdd: ?boolean}"
          }
        }
      ],
      "required": false,
      "default": "true"
    },
    "openCartOnAdd": {
      "type": "boolean",
      "required": false
    },
    "hideSoldOut": {
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    "filterPlacement": {
      "type": "enum",
      "values": [
        "none",
        "chips",
        "sidebar"
      ],
      "required": false,
      "default": "chips"
    },
    "hideOnMobile": {
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    "showSort": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "syncUrl": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "metafields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false
    },
    "loadMoreLabel": {
      "type": "string",
      "required": false,
      "default": "Load more"
    },
    "emptyText": {
      "type": "string",
      "required": false,
      "default": "No products match these filters."
    },
    "__originalHtml": {
      "type": "string",
      "required": false
    }
  },
  "variants": null,
