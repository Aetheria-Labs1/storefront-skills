{
  "contract_version": 2,
  "name": "BuyBox",
  "category": "commerce",
  "capabilities": [
    {
      "name": "product:resolve"
    },
    {
      "name": "cart:add"
    },
    {
      "name": "cart:open"
    }
  ],
  "usage_hint": "Primary PDP purchase interface with variants and quantity. Set syncKey to link a StickyBar with the same key and variant catalog, including headless mode. External selectors use matching data-scope with listenForEvents:true.",
  "when_to_use": "Use on product detail pages where customers need to select options and add items to cart. Supports variants, subscription plans, out-of-stock notify-me, and animated feedback.",
  "when_not_to_use": "Not for collection pages (use QuickAdd instead). Not for sticky follow-up CTAs (use StickyBar). Not for lightweight inline add-to-cart (use QuickAdd).",
  "defaultHydrate": "immediate",
  "combine_with": [
    "The effective Cart V2 profile (renderer-managed)",
    "ProductGallery or ProductHero",
    "VariantSwatches (matching data-scope with listenForEvents:true + showVariantSelector:false)",
    "StickyBar (matching syncKey)"
  ],
  "anti_patterns": [
    "Authoring CartDrawer or DrawerShell in page source: the renderer injects the effective Cart V2 profile",
    "Publishing purchase controls without an effective Cart V2 profile",
    "Using showVariantSelector:true with VariantSwatches: duplicates variant UI (set showVariantSelector:false, listenForEvents:true on BuyBox when using VariantSwatches)",
    "Variant=\"compact\" with multiple variants: loses variant selector, breaking multi-variant products",
    "Setting animate:false then relying on success feedback: removes visual confirmation animations"
  ],
  "props": {
    "product": {
      "type": "object",
      "shape": {
        "title": "string",
        "price": "string",
        "compareAtPrice": "?string",
        "image": "?string",
        "variantId": "?string",
        "variants": "array<{id: string, title: string, price: string, available: boolean, image: ?string, compareAtPrice: ?string}>"
      },
      "required": true
    },
    "ctaText": {
      "type": "string",
      "required": false
    },
    "loadingText": {
      "type": "string",
      "required": false
    },
    "addedText": {
      "type": "string",
      "required": false
    },
    "loadingIndicator": {
      "type": "enum",
      "values": [
        "spinner",
        "none"
      ],
      "required": false
    },
    "successIndicator": {
      "type": "enum",
      "values": [
        "none",
        "check"
      ],
      "required": false
    },
    "listenForEvents": {
      "type": "boolean",
      "required": false
    },
    "syncKey": {
      "type": "string",
      "required": false
    },
    "showVariantSelector": {
      "type": "boolean",
      "required": false
    },
    "showPrice": {
      "type": "boolean",
      "required": false
    },
    "showTrustBadges": {
      "type": "boolean",
      "required": false
    },
    "variant": {
      "type": "enum",
      "values": [
        "default",
        "compact",
        "expanded"
      ],
      "required": false
    },
    "animate": {
      "type": "union",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        }
      ],
      "required": false
    },
    "buttonStyle": {
      "type": "object",
      "shape": {
        "borderRadius": "?string",
        "padding": "?string",
        "fontSize": "?string"
      },
      "required": false
    },
    "__originalHtml": {
      "type": "string",
      "required": false
    }
  },
  "variants": [
    "default",
    "compact",
    "expanded"
  ],
  "css_vars": [
    "--lx-accent-color"
  ],
  "parts": [
    "cta",
    "cta-state",
    "error",
    "notify",
    "qty",
    "qty-btn",
    "root",
    "trust-badges",
    "variant-btn",
    "variants"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate",
      "headless"
    ],
    "headless": {
      "supported": true,
      "hooks": [
        "add",
        "price",
        "compare-price",
        "variant-option",
        "qty",
        "qty-inc",
        "qty-dec",
        "stock",
        "error",
        "add-label",
        "add-idle",
        "add-loading",
        "add-added"
      ]
    }
  }
}
