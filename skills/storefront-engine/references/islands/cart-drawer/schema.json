{
  "contract_version": 2,
  "name": "CartDrawer",
  "category": "commerce",
  "capabilities": [
    {
      "name": "cart:open"
    },
    {
      "name": "overlay"
    }
  ],
  "deprecated": true,
  "replacement": "Cart V2 via head.use_cart_v2",
  "deprecation_reason": "CartDrawer is retained only for legacy pages; new pages must use the Cart V2 profile.",
  "usage_hint": "Compatibility contract for existing pages. Do not author this retired island in new source.",
  "when_to_use": "Inspect an existing page only; use the replacement in workflows/island-selection-workflow.md for new source.",
  "when_not_to_use": "Do not use for new page authoring.",
  "defaultHydrate": "idle",
  "combine_with": [],
  "anti_patterns": [
    "Using CartDrawer on a new page: deprecated \u2014 Cart V2 (use_cart_v2: true) is the default cart",
    "Adding CartDrawer to a use_cart_v2 page: dual cart surfaces, publish validation fails",
    "Multiple CartDrawer instances: creates state conflicts"
  ],
  "props": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "shape": {
          "id": "string",
          "title": "string",
          "variant": "string",
          "price": "string",
          "quantity": "number",
          "image": "?string",
          "handle": "?string"
        }
      },
      "shape": {
        "id": "string",
        "title": "string",
        "variant": "string",
        "price": "string",
        "quantity": "number",
        "image": "?string",
        "handle": "?string"
      },
      "required": true
    },
    "currency": {
      "type": "string",
      "required": false,
      "default": "USD"
    },
    "checkoutUrl": {
      "type": "string",
      "required": false,
      "default": "/checkout"
    },
    "animate": {
      "type": "union",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        }
      ],
      "required": false,
      "default": "true"
    },
    "showClearCart": {
      "type": "boolean",
      "required": false,
      "default": "true"
    }
  },
  "variants": null,
  "css_vars": [
    "--lx-accent-color",
    "--lx-text-color"
  ],
  "parts": [
    "backdrop",
    "checkout",
    "close-btn",
    "content",
    "drawer",
    "footer",
    "header",
    "title"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    }
  }
}
