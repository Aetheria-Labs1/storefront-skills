{
  "contract_version": 2,
  "name": "HeroMedia",
  "category": "hero",
  "capabilities": [],
  "usage_hint": "Full-bleed background media layer for hero sections. Supports static image, carousel (fade/slide), and video modes with parallax, ken-burns, and zoom-on-scroll effects. Positioned absolute to fill its parent section container.",
  "when_to_use": "As the background media layer inside any hero section with position:relative and overflow:hidden. Use for landing page heroes, campaign headers, collection banners, and any section needing immersive full-bleed background media.",
  "when_not_to_use": "Not for inline product images (use ProductGallery). Not for thumbnail galleries (use ProductHero). Not for standalone video players (use VideoPlayer). Not for card-based carousels (use MediaCarousel).",
  "defaultHydrate": "immediate",
  "combine_with": [
    "Hero text overlays (headline",
    "subheadline",
    "CTA)",
    "CountdownTimer (overlaid on hero)",
    "AnnouncementBar (above hero section)"
  ],
  "anti_patterns": [
    "Using without a parent that has position:relative and overflow:hidden (media will escape bounds)",
    "Setting parallax effect on mobile (janky on iOS Safari due to scroll handling)",
    "Using carousel with interval < 3000ms (disorienting, hurts readability of overlaid text)",
    "Using video without poster (shows black frame on slow connections)",
    "Combining ken-burns effect with carousel mode (conflicting animations)",
    "Setting overlay to 0 when text is overlaid on a busy image (text becomes unreadable)"
  ],
  "props": {
    "type": {
      "type": "enum",
      "values": [
        "image",
        "carousel",
        "video"
      ],
      "required": true
    },
    "src": {
      "type": "string",
      "required": false
    },
    "mobileSrc": {
      "type": "string",
      "required": false
    },
    "alt": {
      "type": "string",
      "required": false,
      "default": ""
    },
    "effect": {
      "type": "enum",
      "values": [
        "none",
        "parallax",
        "ken-burns",
        "zoom-on-scroll"
      ],
      "required": false,
      "default": "none"
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "shape": {
          "src": "string",
          "mobileSrc": "?string",
          "alt": "?string"
        }
      },
      "shape": {
        "src": "string",
        "mobileSrc": "?string",
        "alt": "?string"
      },
      "required": false,
      "default": "[]"
    },
    "autoplay": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "interval": {
      "type": "number",
      "required": false,
      "default": "5000"
    },
    "transition": {
      "type": "enum",
      "values": [
        "slide",
        "fade"
      ],
      "required": false,
      "default": "fade"
    },
    "videoSrc": {
      "type": "string",
      "required": false
    },
    "poster": {
      "type": "string",
      "required": false
    },
    "loop": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "muted": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "overlay": {
      "type": "number",
      "required": false,
      "default": "0"
    },
    "overlayColor": {
      "type": "string",
      "required": false,
      "default": "#000000"
    },
    "objectFit": {
      "type": "enum",
      "values": [
        "cover",
        "contain"
      ],
      "required": false,
      "default": "cover"
    },
    "minHeight": {
      "type": "string",
      "required": false,
      "default": "100vh"
    },
    "loading": {
      "type": "enum",
      "values": [
        "eager",
        "lazy"
      ],
      "required": false,
      "default": "eager"
    }
  },
