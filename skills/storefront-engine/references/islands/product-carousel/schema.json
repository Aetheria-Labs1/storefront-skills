{
  "contract_version": 2,
  "name": "ProductCarousel",
  "category": "commerce",
  "usage_hint": "Horizontal scrolling product carousel with arrow navigation and responsive grid columns. Displays ProductCard instances with staggered fade-up animations.",
  "when_to_use": "Use for \"Related Products\", \"You May Also Like\", \"Trending\", or \"Recently Viewed\" sections on PDP or landing pages. Provides quick product browsing without leaving the page.",
  "when_not_to_use": "Not for full-width collections (use collection page with standard grid). Not for single product display (use BuyBox or QuickAdd).",
  "defaultHydrate": "immediate",
  "combine_with": [
    "CartDrawer (REQUIRED if showQuickAdd:true)",
    "BuyBox or other PDP components (common on PDP pages)"
  ],
  "anti_patterns": [
    "Using with fewer than 4 products: carousel arrows are unnecessary, use a static grid instead",
    "Setting showQuickAdd:true without CartDrawer: users get no cart feedback",
    "Overriding columns prop in carousel context: carousel calculates responsive widths; columns prop doesn't apply here",
    "Using cardVariant:\"horizontal\" in carousel: horizontal cards break carousel scroll layout"
  ],
  "props": {
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "shape": {
          "id": "string",
          "handle": "string",
          "title": "string",
          "subtitle": "?string",
          "price": "string",
          "compareAtPrice": "?string",
          "badge": "?string",
          "variants": "?array<{id: object, title: object, price: object, available: object}>",
          "media": "?array<object | object | object>",
          "image": "?string"
        }
      },
      "shape": {
        "id": "string",
        "handle": "string",
        "title": "string",
        "subtitle": "?string",
        "price": "string",
        "compareAtPrice": "?string",
        "badge": "?string",
        "variants": "?array<{id: string, title: string, price: string, available: boolean}>",
        "media": "?array<object | object | object>",
        "image": "?string"
      },
      "required": true
    },
    "title": {
      "type": "string",
      "required": false
    },
    "showQuickAdd": {
      "type": "boolean",
      "required": false
    },
    "showWishlist": {
      "type": "boolean",
      "required": false
    },
    "showLearnMore": {
      "type": "boolean",
      "required": false
    },
    "showQuickView": {
      "type": "boolean",
      "required": false
    },
    "mediaTransition": {
      "type": "enum",
      "values": [
        "none",
        "slide",
        "fade",
        "zoom",
        "kenBurns"
      ],
      "required": false
    },
    "hoverAdvance": {
      "type": "boolean",
      "required": false
    },
    "hoverAdvanceMode": {
      "type": "enum",
      "values": [
        "next",
        "cycle"
      ],
      "required": false
    },
    "hoverInterval": {
      "type": "number",
      "required": false
    },
    "cardVariant": {
      "type": "enum",
      "values": [
        "default",
        "compact",
        "compactRows"
      ],
      "required": false
    },
    "columns": {
      "type": "number",
      "required": false
    },
    "animate": {
      "type": "union",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "required": false
    }
  },
  "variants": [
    "default",
    "compact",
    "compactRows"
  ],
