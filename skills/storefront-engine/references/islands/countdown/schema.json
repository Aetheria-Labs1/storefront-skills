{
  "contract_version": 2,
  "name": "Countdown",
  "category": "content",
  "capabilities": [],
  "usage_hint": "Compatibility contract for existing pages. Do not author this retired island in new source.",
  "when_to_use": "Inspect an existing page only; use the replacement in workflows/island-selection-workflow.md for new source.",
  "when_not_to_use": "Do not use for new page authoring.",
  "defaultHydrate": "immediate",
  "combine_with": [],
  "anti_patterns": [
    "Setting endDate in the past (shows \"Time's up!\" immediately \u2014 test with future dates)",
    "Using countdown for evergreen \"fake urgency\" (resets on page load \u2014 customers notice and distrust)",
    "Placing multiple CountdownTimer instances for same deadline (redundant + confusing)"
  ],
  "props": {
    "endDate": {
      "type": "string",
      "required": true
    },
    "labels": {
      "type": "object",
      "shape": {
        "days": "?string",
        "hours": "?string",
        "minutes": "?string",
        "seconds": "?string"
      },
      "required": false,
      "default": "{}"
    },
    "expiredMessage": {
      "type": "string",
      "required": false,
      "default": "Time's up!"
    },
    "style": {
      "type": "enum",
      "values": [
        "flip",
        "simple",
        "circular",
        "headless"
      ],
      "required": false,
      "default": "simple"
    },
    "expiredAction": {
      "type": "enum",
      "values": [
        "hide",
        "message",
        "redirect"
      ],
      "required": false,
      "default": "message"
    },
    "redirectUrl": {
      "type": "string",
      "required": false
    }
  },
  "variants": [
    "flip",
    "simple",
    "circular",
    "headless"
  ],
  "css_vars": [
    "--lx-accent-color",
    "--lx-countdown-bg",
    "--lx-countdown-border",
    "--lx-countdown-font-size",
    "--lx-countdown-gap",
    "--lx-countdown-label-color",
    "--lx-countdown-label-size",
    "--lx-countdown-radius",
    "--lx-countdown-separator-color",
    "--lx-countdown-separator-size",
    "--lx-countdown-shadow",
    "--lx-countdown-size"
  ],
  "parts": [
    "box",
    "days",
    "digit",
    "expired",
    "hours",
    "label",
    "minutes",
    "ring",
    "root",
    "seconds",
    "separator",
    "unit"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    }
  },
  "deprecated": true,
  "replacement": "CountdownTimer",
  "deprecation_reason": "Countdown remains a runtime compatibility alias; new source must use CountdownTimer.",
  "superseded_by": "CountdownTimer"
}
