{
  "contract_version": 2,
  "name": "Navbar",
  "category": "navigation",
  "capabilities": [
    {
      "name": "cart:open"
    }
  ],
  "usage_hint": "Site-wide top navigation bar with logo, links, cart, and mobile menu.",
  "when_to_use": "When you need persistent navigation across all pages. Supports both hydration mode (custom HTML with data-lx-nav tags) and legacy mode (React-rendered with props). Cart badge auto-syncs with cart state.",
  "when_not_to_use": "For announcement-only headers use AnnouncementBar. For combined announcement + nav use SiteHeader. For page-specific navigation use MobileMenu (standalone mobile sheet).",
  "defaultHydrate": "immediate",
  "combine_with": [
    "Cart V2 via head.use_cart_v2",
    "Footer",
    "AnnouncementBar",
    "native top anchor"
  ],
  "anti_patterns": [
    "Using both SiteHeader and Navbar on the same page \u2014 SiteHeader already includes Navbar functionality",
    "Placing Navbar inside a section wrapper \u2014 it should be a direct page child for sticky positioning to work",
    "Hard-coding cart count instead of omitting it (the island subscribes to real cart state automatically)"
  ],
  "props": {
    "sticky": {
      "type": "boolean",
      "required": false
    },
    "cartMode": {
      "type": "enum",
      "values": [
        "drawer",
        "link"
      ],
      "required": false
    },
    "cartUrl": {
      "type": "string",
      "required": false
    },
    "transparent": {
      "type": "boolean",
      "required": false
    },
    "offsetTop": {
      "type": "string",
      "required": false
    },
    "hideCart": {
      "type": "boolean",
      "required": false
    },
    "logo": {
      "type": "object",
      "shape": {
        "src": "?string",
        "html": "?string",
        "alt": "?string",
        "url": "?string"
      },
      "required": true
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "shape": {
          "label": "string",
          "url": "string",
          "children": "?array<{label: object, url: object, children: ?object}>"
        }
      },
      "shape": {
        "label": "string",
        "url": "string",
        "children": "?array<{label: string, url: string, children: ?object}>"
      },
      "required": true
    },
    "cartCount": {
      "type": "number",
      "required": false
    },
    "style": {
      "type": "object",
      "shape": {
        "bgColor": "?string",
        "textColor": "?string",
        "accentColor": "?string",
        "logoHeight": "?string",
        "height": "?string",
        "borderBottom": "?string",
        "fontFamily": "?string",
        "fontSize": "?string",
        "fontWeight": "?string",
        "padding": "?string",
        "maxWidth": "?string",
        "dropdownBg": "?string",
        "dropdownTextColor": "?string",
        "mobileBg": "?string",
        "mobileTextColor": "?string"
      },
      "required": false
    },
    "cta": {
      "type": "object",
      "shape": {
        "label": "string",
        "url": "string"
      },
      "required": false
    },
    "cart": {
      "type": "object",
      "shape": {
        "icon": "?'cart' | 'bag' | 'basket'",
        "svg": "?string",
        "image": "?string",
        "label": "?string",
        "badgeColor": "?string"
      },
      "required": false
    }
  },
  "variants": null,
  "css_vars": [
    "--lx-accent-color"
  ],
  "parts": [
    "cart-badge",
    "cart-trigger",
    "cta",
    "dropdown",
    "dropdown-item",
    "link",
    "links",
    "logo",
    "mobile-link",
    "mobile-panel",
    "mobile-trigger",
    "root"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    }
  }
}
