{
  "contract_version": 2,
  "name": "ReviewList",
  "category": "social_proof",
  "usage_hint": "Full interactive review list with sort, filter, pagination, demographics sidebar, media thumbnails, and helpful votes. Stamped.io-style layout for DTC landing pages.",
  "when_to_use": "When you need a paginated, sortable review section with rich content (demographics, media, helpful votes). For trust-building social proof sections on PDPs or landing pages.",
  "when_not_to_use": "For decorative review showcases (use ReviewCarousel). For single featured reviews (use a static review card in HTML). For video testimonial carousels (use existing testimonial sections).",
  "defaultHydrate": "visible",
  "combine_with": [
    "TrustBadgeBar",
    "BuyBox",
    "FAQ",
    "StickyBar"
  ],
  "anti_patterns": [
    "Using both reviews[] and reviewsEndpoint (reviews[] takes priority; pick one mode)",
    "Setting pageSize > 20 (too many DOM nodes; keep 5-10 for initial load)",
    "Passing reviews without id field when helpfulEndpoint is set (votes need review identity)",
    "Using variant=\"stamped\" without demographics data (sidebar renders empty; use \"minimal\" instead)"
  ],
  "props": {
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "shape": {
          "id": "?string",
          "author": "string",
          "rating": "number",
          "title": "?string",
          "body": "string",
          "date": "?string",
          "verified": "?boolean | boolean",
          "featured": "?boolean | boolean",
          "avatar": "?string",
          "demographics": "?array<{label: object, value: object}>",
          "improvements": "?array<string>",
          "media": "?array<{type: object, urls: object, thumbnail: ?object, alt: ?object}>",
          "helpful_count": "?number",
          "unhelpful_count": "?number"
        }
      },
      "shape": {
        "id": "?string",
        "author": "string",
        "rating": "number",
        "title": "?string",
        "body": "string",
        "date": "?string",
        "verified": "?boolean | boolean",
        "featured": "?boolean | boolean",
        "avatar": "?string",
        "demographics": "?array<{label: string, value: string}>",
        "improvements": "?array<string>",
        "media": "?array<{type: 'image' | 'video', urls: array<object>, thumbnail: ?object, alt: ?object}>",
        "helpful_count": "?number",
        "unhelpful_count": "?number"
      },
      "required": false
    },
    "reviewsEndpoint": {
      "type": "string",
      "required": false
    },
    "variant": {
      "type": "enum",
      "values": [
        "minimal",
        "stamped",
        "summaryAside"
      ],
      "required": false,
      "default": "stamped"
    },
    "averageRating": {
      "type": "number",
      "required": false
    },
    "totalReviews": {
      "type": "number",
      "required": false
    },
    "pageSize": {
      "type": "number",
      "required": false,
      "default": "5"
    },
    "showDemographics": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "showHelpful": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "showFilters": {
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    "showSort": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "showMedia": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "showHeader": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "helpfulEndpoint": {
      "type": "string",
      "required": false
    },
    "productIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false
    },
    "collectionId": {
      "type": "string",
      "required": false
    },
    "reviewSnapshotId": {
      "type": "string",
      "required": false
    },
    "sort": {
      "type": "enum",
      "values": [
        "recent",
        "highest",
        "featured"
      ],
      "required": false
    }
  },
  "variants": [
    "minimal",
    "stamped",
    "summaryAside"
  ],
  "css_vars": [
    "--lx-accent-color",
    "--lx-bg-surface",
    "--lx-review-accent",
    "--lx-review-border",
    "--lx-review-border-color",
    "--lx-review-card-bg",
    "--lx-review-muted",
    "--lx-review-text",
    "--lx-shoppable-button-radius",
    "--lx-shoppable-control-bg",
    "--lx-shoppable-control-border",
    "--lx-shoppable-control-color",
    "--lx-shoppable-control-hover",
    "--lx-shoppable-control-size",
    "--lx-shoppable-progress-bg",
    "--lx-shoppable-progress-color",
    "--lx-shoppable-progress-height",
    "--lx-shoppable-radius",
    "--lx-shoppable-video-bg",
    "--lx-shoppable-video-error-bg",
    "--lx-text-color",
    "--lx-video-bg",
    "--lx-video-button-bg",
    "--lx-video-button-color",
    "--lx-video-button-padding-x",
    "--lx-video-button-radius",
    "--lx-video-control-bg",
    "--lx-video-control-border",
    "--lx-video-control-color",
    "--lx-video-control-gap",
    "--lx-video-control-hover",
    "--lx-video-control-inset",
    "--lx-video-control-radius",
    "--lx-video-control-size",
    "--lx-video-control-transition",
    "--lx-video-error-bg",
    "--lx-video-error-color",
    "--lx-video-error-padding",
    "--lx-video-focus-color",
    "--lx-video-object-fit",
    "--lx-video-preview-fit",
    "--lx-video-preview-opacity",
    "--lx-video-progress-bg",
    "--lx-video-progress-color",
    "--lx-video-progress-height",
    "--lx-video-radius"
  ],
  "parts": [
    "adaptive-video",
    "adaptive-video-controls",
    "adaptive-video-element",
    "adaptive-video-error",
    "adaptive-video-error-content",
    "adaptive-video-error-message",
    "adaptive-video-mute",
    "adaptive-video-play",
    "adaptive-video-preview",
    "adaptive-video-preview-media",
    "adaptive-video-progress",
    "adaptive-video-progress-fill",
    "adaptive-video-retry",
    "feed",
    "filters",
    "header",
    "load-more",
    "review-list",
    "root",
    "sort",
    "summary",
    "summary-layout",
    "toolbar"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    },
    "example": "<lx-island name=\"ReviewList\">\n  <script type=\"application/json\">\n{}\n  </script>\n</lx-island>",
    "examples": [
      {
        "label": "Stamped.io layout with demographics sidebar and helpful votes",
        "source": "<lx-island name=\"ReviewList\">\n  <script type=\"application/json\">{\"reviews\":[{\"id\":\"1\",\"author\":\"Gina S.\",\"rating\":5,\"title\":\"Life changing!\",\"body\":\"Thesis has been a part of my life throughout my doctoral program.\",\"featured\":true,\"demographics\":[{\"label\":\"Age Range\",\"value\":\"55+\"},{\"label\":\"Gender\",\"value\":\"Female\"}],\"improvements\":[\"Focus\",\"Memory\",\"Mood\"],\"helpful_count\":165,\"unhelpful_count\":28}],\"variant\":\"stamped\",\"showDemographics\":true,\"showHelpful\":true,\"averageRating\":4.6,\"totalReviews\":3243}</script>\n</lx-island>"
      },
      {
        "label": "Minimal variant - compact text reviews",
        "source": "<lx-island name=\"ReviewList\">\n  <script type=\"application/json\">{\"reviews\":[{\"author\":\"Sarah M.\",\"rating\":5,\"body\":\"Absolutely love this product!\",\"verified\":true},{\"author\":\"Mike R.\",\"rating\":4,\"body\":\"Great value for money.\",\"verified\":true}],\"variant\":\"minimal\",\"showSort\":true,\"pageSize\":5}</script>\n</lx-island>"
      },
      {
        "label": "Fetch mode with API endpoint",
        "source": "<lx-island name=\"ReviewList\">\n  <script type=\"application/json\">{\"reviewsEndpoint\":\"/api/v1/storefront/public/reviews/store123\",\"sort\":\"featured\",\"pageSize\":5,\"variant\":\"stamped\",\"showDemographics\":true,\"showHelpful\":true,\"showFilters\":true,\"showSort\":true,\"averageRating\":4.6,\"totalReviews\":3243}</script>\n</lx-island>"
      }
    ]
  }
}
