{
  "name": "ReviewList",
  "category": "unknown",
  "usage_hint": "Full interactive review list with sort, filter, pagination, demographics sidebar, media thumbnails, and helpful votes. Stamped.io-style layout for DTC landing pages.",
  "when_to_use": "When you need a paginated, sortable review section with rich content (demographics, media, helpful votes). For trust-building social proof sections on PDPs or landing pages.",
  "when_not_to_use": "For decorative review showcases (use ReviewCarousel). For single featured reviews (use a static review card in HTML). For video testimonial carousels (use existing testimonial sections).",
  "defaultHydrate": "visible",
  "combine_with": [
    "TrustBadgeBar",
    "BuyBox",
    "FAQ",
    "StickyBar"
  ],
  "anti_patterns": [
    "Using both reviews[] and reviewsEndpoint (reviews[] takes priority; pick one mode)",
    "Setting pageSize > 20 (too many DOM nodes; keep 5-10 for initial load)",
    "Passing reviews without id field when helpfulEndpoint is set (votes need review identity)",
    "Using variant=\"stamped\" without demographics data (sidebar renders empty; use \"minimal\" instead)"
  ],
  "examples": [
    {
      "label": "Stamped.io layout with demographics sidebar and helpful votes",
      "html": "<div data-island=\"ReviewList\" data-props='{\"reviews\":[{\"id\":\"1\",\"author\":\"Gina S.\",\"rating\":5,\"title\":\"Life changing!\",\"body\":\"Thesis has been a part of my life throughout my doctoral program.\",\"featured\":true,\"demographics\":[{\"label\":\"Age Range\",\"value\":\"55+\"},{\"label\":\"Gender\",\"value\":\"Female\"}],\"improvements\":[\"Focus\",\"Memory\",\"Mood\"],\"helpful_count\":165,\"unhelpful_count\":28}],\"variant\":\"stamped\",\"showDemographics\":true,\"showHelpful\":true,\"averageRating\":4.6,\"totalReviews\":3243}'></div>"
    },
    {
      "label": "Minimal variant - compact text reviews",
      "html": "<div data-island=\"ReviewList\" data-props='{\"reviews\":[{\"author\":\"Sarah M.\",\"rating\":5,\"body\":\"Absolutely love this product!\",\"verified\":true},{\"author\":\"Mike R.\",\"rating\":4,\"body\":\"Great value for money.\",\"verified\":true}],\"variant\":\"minimal\",\"showSort\":true,\"pageSize\":5}'></div>"
    },
    {
      "label": "Fetch mode with API endpoint",
      "html": "<div data-island=\"ReviewList\" data-props='{\"reviewsEndpoint\":\"/api/v1/storefront/public/reviews/store123\",\"sort\":\"featured\",\"pageSize\":5,\"variant\":\"stamped\",\"showDemographics\":true,\"showHelpful\":true,\"showFilters\":true,\"showSort\":true,\"averageRating\":4.6,\"totalReviews\":3243}'></div>"
    }
  ],
  "props": {
    "reviews": {
      "type": "array",
      "required": false,
      "shape": {
        "id": "?string",
        "author": "string",
        "rating": "number",
        "title": "?string",
        "body": "string",
        "date": "?string",
        "verified": "?boolean",
        "featured": "?boolean",
        "avatar": "?string",
        "demographics": "?array<{label: string, value: string}>",
        "improvements": "?array<string>",
        "media": "?array<{type: 'image' | 'video', urls: array<string>, thumbnail: ?string, alt: ?string}>",
        "helpful_count": "?number",
        "unhelpful_count": "?number"
      }
    },
    "reviewsEndpoint": {
      "type": "string",
      "required": false
    },
    "variant": {
      "type": "enum",
      "required": false,
      "values": [
        "minimal",
        "stamped"
      ],
      "default": "stamped"
    },
    "averageRating": {
      "type": "number",
      "required": false
    },
    "totalReviews": {
      "type": "number",
      "required": false
    },
    "pageSize": {
      "type": "number",
      "required": false,
      "default": "5"
    },
    "showDemographics": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "showHelpful": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "showFilters": {
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    "showSort": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "showMedia": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "showHeader": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "helpfulEndpoint": {
      "type": "string",
      "required": false
    },
    "productIds": {
      "type": "array",
      "required": false
    },
    "sort": {
      "type": "enum",
      "required": false,
      "values": [
        "recent",
        "highest",
        "featured"
      ]
    }
  },
  "variants": [
    "minimal",
    "stamped"
  ],
  "css_vars": [
    "--lx-review-accent",
    "--lx-review-border",
    "--lx-review-border-color",
    "--lx-review-card-bg",
    "--lx-review-muted",
    "--lx-review-text"
  ],
  "parts": [
    "filters",
    "header",
    "load-more",
    "review-list",
    "root",
    "sort",
    "toolbar"
  ],
  "example": "<div data-island=\"ReviewList\" data-props='{}'></div>"
}
