{
  "contract_version": 2,
  "name": "ReviewCarousel",
  "category": "social_proof",
  "capabilities": [],
  "usage_hint": "Rotating customer review showcase with star ratings, typically placed below product info or before FAQ on PDPs. Supports static reviews array or runtime fetch from our reviews API.",
  "when_to_use": "When you have 3+ customer reviews to display and want to build trust through social proof. Supports two modes: static reviews array (baked in) or fetch mode (reviewsEndpoint + productIds for live data from our API).",
  "when_not_to_use": "For single reviews (just show the review card directly). For real-time streaming review feeds (this fetches a batch, not a live stream).",
  "defaultHydrate": "visible",
  "combine_with": [
    "BuyBox",
    "ProductGallery",
    "StickyBar"
  ],
  "anti_patterns": [
    "Passing more than 12 reviews in static mode (carousel becomes too long; pre-filter to top reviews by rating/helpfulness)",
    "Using minimal variant with long review bodies (text doesn't truncate well; use grid or default instead)",
    "Setting interval below 3000ms (users can't read reviews; keep it \u22654000ms)",
    "Mixing verified and unverified reviews without the verified flag (damages trust; always mark verified purchases)",
    "Using both reviews[] and reviewsEndpoint (reviews[] takes priority; pick one mode)",
    "Writing reviewsEndpoint with a placeholder page id \u2014 omit it, the page supplies the endpoint at runtime"
  ],
  "props": {
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "shape": {
          "id": "?string",
          "author": "string",
          "rating": "number",
          "title": "?string",
          "body": "string",
          "date": "?string",
          "verified": "?boolean | boolean",
          "avatar": "?string",
          "helpful_count": "?number",
          "media": "?array<{type: object, urls: object, thumbnail: ?object, alt: ?object}>"
        }
      },
      "shape": {
        "id": "?string",
        "author": "string",
        "rating": "number",
        "title": "?string",
        "body": "string",
        "date": "?string",
        "verified": "?boolean | boolean",
        "avatar": "?string",
        "helpful_count": "?number",
        "media": "?array<{type: 'image' | 'video', urls: array<object>, thumbnail: ?object, alt: ?object}>"
      },
      "required": false
    },
    "reviewsEndpoint": {
      "type": "string",
      "required": false
    },
    "productIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false
    },
    "collectionId": {
      "type": "string",
      "required": false
    },
    "reviewSnapshotId": {
      "type": "string",
      "required": false
    },
    "minRating": {
      "type": "number",
      "required": false
    },
    "sort": {
      "type": "enum",
      "values": [
        "recent",
        "highest",
        "most_helpful"
      ],
      "required": false
    },
    "pageSize": {
      "type": "number",
      "required": false,
      "default": "10"
    },
    "autoplay": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "interval": {
      "type": "number",
      "required": false,
      "default": "5000"
    },
    "variant": {
      "type": "enum",
      "values": [
        "default",
        "compact",
        "minimal",
        "grid"
      ],
      "required": false,
      "default": "default"
    }
  },
  "variants": [
    "default",
    "compact",
    "minimal",
    "grid"
  ],
  "css_vars": [
    "--lx-accent-color",
    "--lx-text-color"
  ],
  "parts": [
    "author",
    "avatar",
    "body",
    "card",
    "date",
    "dot",
    "dots",
    "load-more",
    "media-preview",
    "nav-next",
    "nav-prev",
    "root",
    "title",
    "verified"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    }
  }
}
