{
  "contract_version": 2,
  "name": "SocialProofPopup",
  "category": "social_proof",
  "capabilities": [
    {
      "name": "overlay"
    }
  ],
  "usage_hint": "Compatibility contract. The proof-ledger policy disallows activity-popup proof in new pages.",
  "when_to_use": "Inspect existing pages only; select eligible proof through proof/proof-ledger.md.",
  "when_not_to_use": "Do not author activity-popup proof in new pages.",
  "defaultHydrate": "visible",
  "combine_with": [],
  "anti_patterns": [
    "Multiple popups on one page (chaos; only one global instance per site)",
    "Showing fake/synthetic events without real data (destroys trust if users notice)",
    "Setting delay or interval too low (<3000ms delay, <6000ms interval; users can't read)",
    "Using both events[] and socialProofEndpoint (events[] takes priority; pick one mode)",
    "Using on pages with other competing popups (email capture, exit intent; pick one)"
  ],
  "props": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "shape": {
          "name": "string",
          "product": "string",
          "location": "?string",
          "time": "?string",
          "image": "?string"
        }
      },
      "shape": {
        "name": "string",
        "product": "string",
        "location": "?string",
        "time": "?string",
        "image": "?string"
      },
      "required": false
    },
    "socialProofEndpoint": {
      "type": "string",
      "required": false
    },
    "productId": {
      "type": "string",
      "required": false
    },
    "storeId": {
      "type": "string",
      "required": false
    },
    "batchSize": {
      "type": "number",
      "required": false,
      "default": "10"
    },
    "refreshInterval": {
      "type": "number",
      "required": false,
      "default": "300000"
    },
    "delay": {
      "type": "number",
      "required": false
    },
    "delayMs": {
      "type": "number",
      "required": false
    },
    "duration": {
      "type": "number",
      "required": false
    },
    "durationMs": {
      "type": "number",
      "required": false
    },
    "interval": {
      "type": "number",
      "required": false,
      "default": "8000"
    },
    "position": {
      "type": "enum",
      "values": [
        "bottom-left",
        "bottom-right",
        "top-banner"
      ],
      "required": false,
      "default": "bottom-left"
    },
    "showProductImage": {
      "type": "boolean",
      "required": false,
      "default": "true"
    }
  },
  "variants": null,
  "css_vars": [
    "--lx-accent-color",
    "--lx-text-color"
  ],
  "parts": [
    "card",
    "image",
    "name",
    "product",
    "root",
    "time"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    }
  }
}
