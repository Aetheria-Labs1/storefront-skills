{
  "contract_version": 2,
  "name": "SubscriptionToggle",
  "category": "commerce",
  "capabilities": [
    {
      "name": "product:resolve"
    }
  ],
  "usage_hint": "Subscribe-and-save toggle that switches between one-time purchase and subscription pricing. Emits subscription:changed events to BuyBox.",
  "when_to_use": "On product pages with subscription selling plans. Auto-emits state changes so BuyBox/AddToCart islands can update checkout behavior. Shows discount, frequency options, and benefits list.",
  "when_not_to_use": "For products without subscription options. For simple quantity selectors use BuyBox quantity field. For tiered pricing use QuantityBreaks instead.",
  "defaultHydrate": "immediate",
  "combine_with": [
    "BuyBox",
    "AddToCart",
    "ProductPrice (all listen for subscription:changed events)"
  ],
  "anti_patterns": [
    "Not providing valid Shopify selling plan IDs — checkout will fail",
    "Listing benefits that don't match actual subscription terms (misleading)",
    "Using alongside QuantityBreaks (they conflict — choose one pricing model)"
  ],
  "props": {
    "oneTimePrice": {
      "type": "string",
      "required": true
    },
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "shape": {
          "id": "string",
          "frequency": "string",
          "discount": "string",
          "price": "string"
        }
      },
      "shape": {
        "id": "string",
        "frequency": "string",
        "discount": "string",
        "price": "string"
      },
      "required": true
    },
    "benefits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false
    },
    "defaultMode": {
      "type": "enum",
      "values": [
        "one-time",
        "subscribe"
      ],
      "required": false,
      "default": "one-time"
    },
    "label": {
      "type": "string",
      "required": false
    }
  },
  "variants": null,
  "css_vars": [
    "--lx-accent-color",
    "--lx-text-color"
  ],
  "parts": [
    "benefit-item",
    "benefits",
    "frequency-select",
    "label",
    "option-one-time",
    "option-subscribe",
    "root"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    },
    "example": "<lx-island name=\"SubscriptionToggle\">\n  <script type=\"application/json\">\n{\n  \"oneTimePrice\": \"example-oneTimePrice\",\n  \"plans\": [\n    {\n      \"id\": \"example-id\",\n      \"frequency\": \"example-frequency\",\n      \"discount\": \"example-discount\",\n      \"price\": \"example-price\"\n    }\n  ]\n}\n  </script>\n</lx-island>",
    "examples": [
      {
        "label": "Monthly subscription with benefits",
        "source": "<lx-island name=\"SubscriptionToggle\">\n  <script type=\"application/json\">{\"oneTimePrice\":\"$29.99\",\"plans\":[{\"id\":\"gid://shopify/SellingPlan/123\",\"frequency\":\"Every month\",\"discount\":\"10%\",\"price\":\"$26.99\"}],\"benefits\":[\"Never run out\",\"Cancel anytime\",\"Free shipping\"],\"defaultMode\":\"subscribe\",\"label\":\"Purchase Options\"}</script>\n</lx-island>"
      },
      {
        "label": "Multiple frequency options",
        "source": "<lx-island name=\"SubscriptionToggle\">\n  <script type=\"application/json\">{\"oneTimePrice\":\"$49.99\",\"plans\":[{\"id\":\"gid://shopify/SellingPlan/456\",\"frequency\":\"Every 2 weeks\",\"discount\":\"5%\",\"price\":\"$47.49\"},{\"id\":\"gid://shopify/SellingPlan/457\",\"frequency\":\"Every month\",\"discount\":\"10%\",\"price\":\"$44.99\"},{\"id\":\"gid://shopify/SellingPlan/458\",\"frequency\":\"Every 3 months\",\"discount\":\"15%\",\"price\":\"$42.49\"}],\"benefits\":[\"Priority support\",\"Exclusive discounts\"],\"defaultMode\":\"one-time\"}</script>\n</lx-island>"
      },
      {
        "label": "Simple subscribe-and-save",
        "source": "<lx-island name=\"SubscriptionToggle\">\n  <script type=\"application/json\">{\"oneTimePrice\":\"$19.99\",\"plans\":[{\"id\":\"gid://shopify/SellingPlan/789\",\"frequency\":\"Monthly delivery\",\"discount\":\"15%\",\"price\":\"$16.99\"}]}</script>\n</lx-island>"
      }
    ]
  }
}
