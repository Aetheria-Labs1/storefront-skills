    "video-poster",
    "viewport"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    }
  }
}
