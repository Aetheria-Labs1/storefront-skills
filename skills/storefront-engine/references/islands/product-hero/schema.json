{
  "contract_version": 2,
  "name": "ProductHero",
  "category": "commerce",
  "capabilities": [
    {
      "name": "product:resolve"
    },
    {
      "name": "media:carousel"
    }
  ],
  "usage_hint": "Premium PDP hero gallery with thumbnail or dot navigation, autoplay, swipe, accessible arrows, and scoped variant-media focus/filter/replace behavior.",
  "when_to_use": "Use for high-end PDP split layouts where large product media sits alongside a BuyBox. Use navigation:\"arrows\" for persistent controls or \"floatingArrows\" for mounted controls that appear on hover/focus.",
  "when_not_to_use": "Not for compact galleries (use ProductGallery). Not for generic landing-page banners. Not for card media (use MediaCarousel).",
  "defaultHydrate": "visible",
  "combine_with": [
    "BuyBox",
    "VariantSwatches (matching data-scope and listenForVariant:true)"
  ],
  "anti_patterns": [
    "Omitting data-scope when more than one product interaction group exists on the page",
    "Using variantMediaMode:\"replace\" when the complete gallery should remain available",
    "Enabling autoplay with fewer than two media items"
  ],
  "props": {
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "shape": {
          "url": "string",
          "id": "?string",
          "variantId": "?string",
          "variantIds": "?array<string>",
          "type": "?'image' | 'video'",
          "src": "?string",
          "alt": "?string",
          "poster": "?string",
          "mobileSrc": "?string",
          "srcSet": "?string",
          "srcSetWebp": "?string",
          "sizes": "?string",
          "fit": "?'cover' | 'contain'",
          "objectFit": "?'cover' | 'contain'",
          "objectPosition": "?string",
          "sources": "?array<{type: ?'application/x-mpegURL' | 'application/vnd.apple.mpegurl' | 'application/dash+xml' | 'video/mp4' | 'video/webm' | 'video/ogg', url: string, width: ?number, height: ?number, bitrate: ?number}>",
          "preview": "?{url: string, type: 'video/mp4' | 'image/gif' | 'image/webp', poster: ?string}",
          "captionsUrl": "?string",
          "assetId": "?string",
          "provider": "?'cloudflare_stream' | 'cloudflare_cdn' | 'external'"
        }
      },
      "shape": {
        "url": "string",
        "id": "?string",
        "variantId": "?string",
        "variantIds": "?array<string>",
        "type": "?'image' | 'video'",
        "src": "?string",
        "alt": "?string",
        "poster": "?string",
        "mobileSrc": "?string",
        "srcSet": "?string",
        "srcSetWebp": "?string",
        "sizes": "?string",
        "fit": "?'cover' | 'contain'",
        "objectFit": "?'cover' | 'contain'",
        "objectPosition": "?string",
        "sources": "?array<{type: ?'application/x-mpegURL' | 'application/vnd.apple.mpegurl' | 'application/dash+xml' | 'video/mp4' | 'video/webm' | 'video/ogg', url: string, width: ?number, height: ?number, bitrate: ?number}>",
        "preview": "?{url: string, type: 'video/mp4' | 'image/gif' | 'image/webp', poster: ?string}",
        "captionsUrl": "?string",
        "assetId": "?string",
        "provider": "?'cloudflare_stream' | 'cloudflare_cdn' | 'external'"
      },
      "required": true
    },
    "layout": {
      "type": "enum",
      "values": [
        "stacked",
        "splitLeft",
        "splitRight",
        "fullHeight"
      ],
      "required": false,
      "default": "splitLeft"
    },
    "thumbnails": {
      "type": "enum",
      "values": [
        "none",
        "rail",
        "dots"
      ],
      "required": false,
      "default": "rail"
    },
    "thumbnailPosition": {
      "type": "enum",
      "values": [
        "left",
        "right",
        "bottom"
      ],
      "required": false,
      "default": "left"
    },
    "navigation": {
      "type": "enum",
      "values": [
        "none",
        "arrows",
        "floatingArrows"
      ],
      "required": false,
      "default": "floatingArrows"
    },
    "aspectRatio": {
      "type": "string",
      "required": false,
      "default": "3:4"
    },
    "maxHeight": {
      "type": "string",
      "required": false,
      "default": "85vh"
    },
    "transition": {
      "type": "enum",
      "values": [
        "none",
        "slide",
        "fade",
        "zoom",
        "kenBurns"
      ],
      "required": false,
      "default": "fade"
    },
    "listenForVariant": {
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    "variantMediaMode": {
      "type": "enum",
      "values": [
        "focus",
        "filter",
        "replace"
      ],
      "required": false,
      "default": "focus"
    },
    "autoplay": {
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    "interval": {
      "type": "number",
      "required": false,
      "default": "4000"
    },
    "hoverAdvance": {
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    "loop": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "swipe": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "showIndicators": {
      "type": "boolean",
      "required": false,
      "deprecated": true,
      "description": "Use thumbnails:\"dots\".",
      "aliasFor": "thumbnails",
      "precedence": "`thumbnails` takes precedence. Use thumbnails:\"dots\" instead of showIndicators:true."
    },
    "className": {
      "type": "string",
      "required": false
    }
  },
  "variants": [
    "stacked",
    "splitLeft",
    "splitRight",
    "fullHeight"
  ],
  "css_vars": [
    "--lx-accent-color",
    "--lx-bg-surface",
    "--lx-border-color",
    "--lx-featured-media-arrow-bg",
    "--lx-featured-media-arrow-border",
    "--lx-featured-media-arrow-color",
    "--lx-featured-media-arrow-inset",
    "--lx-featured-media-arrow-radius",
    "--lx-featured-media-arrow-shadow",
    "--lx-featured-media-arrow-size",
    "--lx-featured-media-dot-color",
    "--lx-featured-media-dot-gap",
    "--lx-featured-media-dot-size",
    "--lx-featured-media-dots-bottom",
    "--lx-hero-bg",
    "--lx-hero-radius",
    "--lx-hero-thumb-gap",
    "--lx-hero-thumb-radius",
    "--lx-hero-thumb-size",
    "--lx-media-carousel-arrow-bg",
    "--lx-media-carousel-arrow-border",
    "--lx-media-carousel-arrow-color",
    "--lx-media-carousel-arrow-hover-bg",
    "--lx-media-carousel-arrow-offset",
    "--lx-media-carousel-arrow-radius",
    "--lx-media-carousel-arrow-shadow",
    "--lx-media-carousel-arrow-size",
    "--lx-media-carousel-bg",
    "--lx-media-carousel-dot-active-color",
    "--lx-media-carousel-dot-active-scale",
    "--lx-media-carousel-dot-color",
    "--lx-media-carousel-dot-gap",
    "--lx-media-carousel-dot-offset",
    "--lx-media-carousel-dot-shadow",
    "--lx-media-carousel-dot-size",
    "--lx-media-carousel-duration",
    "--lx-media-carousel-ease",
    "--lx-media-carousel-fit",
    "--lx-media-carousel-focus-color",
    "--lx-media-carousel-focus-offset",
    "--lx-media-carousel-focus-width",
    "--lx-media-carousel-placeholder",
    "--lx-media-carousel-radius",
    "--lx-shoppable-button-radius",
    "--lx-shoppable-control-bg",
