{
  "name": "ProductHero",
  "category": "commerce",
  "usage_hint": "Premium full-height hero gallery for PDP split layouts. Supports fade/slide/zoom/kenBurns transitions, thumbnail rail, autoplay, hover-advance, and variant sync. Fully CSS-customizable via data-part attributes and --lx-hero-* properties.",
  "when_to_use": "Use for high-end PDP layouts where media occupies 50-60% of viewport height and sits alongside BuyBox. Ideal for fashion, furniture, premium goods where large immersive media is key.",
  "when_not_to_use": "Not for compact galleries (use ProductGallery). Not for hero banners on landing pages. Not for card-based media (use MediaCarousel).",
  "defaultHydrate": "visible",
  "combine_with": [
    "BuyBox (side-by-side split layout)",
    "VariantSwatches (when listenForVariant:true",
    "hero updates images on variant change)"
  ],
  "anti_patterns": [
    "Using on mobile without testing: full-height hero can push BuyBox too far down",
    "Setting maxHeight too high: creates whitespace on smaller screens",
    "Using autoplay with very short interval (<2000ms): disorienting"
  ],
  "examples": [
    {
      "label": "Split-left hero with thumbnail rail and autoplay",
      "html": "<div data-island=\"ProductHero\" data-props='{\"images\":[{\"url\":\"https://via.placeholder.com/800x1000\",\"alt\":\"Product 1\"},{\"url\":\"https://via.placeholder.com/800x1000\",\"alt\":\"Product 2\"},{\"url\":\"https://via.placeholder.com/800x1000\",\"alt\":\"Product 3\"}],\"layout\":\"splitLeft\",\"thumbnails\":\"rail\",\"thumbnailPosition\":\"left\",\"autoplay\":true,\"transition\":\"fade\"}'></div>"
    },
    {
      "label": "Full-height cinematic with kenBurns",
      "html": "<div data-island=\"ProductHero\" data-props='{\"images\":[{\"url\":\"https://via.placeholder.com/1200x800\",\"alt\":\"Hero 1\"},{\"url\":\"https://via.placeholder.com/1200x800\",\"alt\":\"Hero 2\"}],\"layout\":\"fullHeight\",\"transition\":\"kenBurns\",\"autoplay\":true,\"thumbnails\":\"none\",\"navigation\":\"none\"}'></div>"
    },
    {
      "label": "Hover-advance, no arrows",
      "html": "<div data-island=\"ProductHero\" data-props='{\"images\":[{\"url\":\"https://via.placeholder.com/800\",\"alt\":\"A\"},{\"url\":\"https://via.placeholder.com/800\",\"alt\":\"B\"}],\"hoverAdvance\":true,\"thumbnails\":\"rail\",\"navigation\":\"none\"}'></div>"
    }
  ],
  "props": {
    "images": {
      "type": "array",
      "required": true,
      "shape": {
        "url": "string",
        "alt": "?string",
        "objectFit": "?'cover' | 'contain'",
        "objectPosition": "?string"
      }
    },
    "layout": {
      "type": "enum",
      "required": false,
      "values": [
        "stacked",
        "splitLeft",
        "splitRight",
        "fullHeight"
      ],
      "default": "splitLeft"
    },
    "thumbnails": {
      "type": "enum",
      "required": false,
      "values": [
        "none",
        "rail",
        "dots"
      ],
      "default": "rail"
    },
    "thumbnailPosition": {
      "type": "enum",
      "required": false,
      "values": [
        "left",
        "right",
        "bottom"
      ],
      "default": "left"
    },
    "navigation": {
      "type": "enum",
      "required": false,
      "values": [
        "none",
        "arrows",
        "floatingArrows"
      ],
      "default": "floatingArrows"
    },
    "aspectRatio": {
      "type": "string",
      "required": false,
      "default": "3:4"
    },
    "maxHeight": {
      "type": "string",
      "required": false,
      "default": "85vh"
    },
    "transition": {
      "type": "enum",
      "required": false,
      "values": [
        "none",
        "fade",
        "slide",
        "zoom",
        "kenBurns"
      ],
      "default": "fade"
    },
    "listenForVariant": {
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    "autoplay": {
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    "interval": {
      "type": "number",
      "required": false,
      "default": "4000"
    },
    "hoverAdvance": {
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    "showIndicators": {
      "type": "boolean",
      "required": false
    },
    "className": {
      "type": "string",
      "required": false
    }
  },
  "variants": [
    "stacked",
    "splitLeft",
    "splitRight",
    "fullHeight"
  ],
  "css_vars": [
    "--lx-accent-color",
    "--lx-border-color",
    "--lx-hero-",
    "--lx-hero-arrow-bg",
    "--lx-hero-arrow-offset",
    "--lx-hero-arrow-size",
    "--lx-hero-bg",
    "--lx-hero-radius",
    "--lx-hero-thumb-gap",
    "--lx-hero-thumb-radius",
    "--lx-hero-thumb-size",
    "--lx-hero-transition-duration"
  ],
  "parts": [
    "dot",
    "media-pane",
    "nav-next",
    "nav-prev",
    "root",
    "slide",
    "thumbnail",
    "thumbnail-rail"
  ],
  "example": "<div data-island=\"ProductHero\" data-props='{\"images\":[{\"url\":\"example-url\"}]}'></div>"
}
