{
  "contract_version": 2,
  "name": "FeaturedCollectionStage",
  "category": "commerce",
  "usage_hint": "Editorial multi-product collection stage with a shared backdrop, active-product details, image/video media, and CSS-first layout controls.",
  "when_to_use": "Use for featured collections, new arrivals, or best-seller sections where several large unframed products share one visual stage.",
  "when_not_to_use": "Not for conventional boxed product cards (use ProductCarousel) or a single product presentation (use ProductHero).",
  "defaultHydrate": "visible",
  "combine_with": [
    "Navbar",
    "CartDrawer",
    "AnnouncementBar"
  ],
  "anti_patterns": [
    "Using fewer than three products: the shared stage loses its collection context",
    "Adding nested carousels inside product media: horizontal gestures conflict with the collection rail",
    "Hardcoding item widths in authored HTML: use the exposed featured-stage CSS variables instead"
  ],
  "props": {
    "productIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "shape": {
          "id": "string",
          "handle": "string",
          "variantId": "?string",
          "title": "string",
          "subtitle": "?string",
          "price": "string",
          "compareAtPrice": "?string",
          "badge": "?string",
          "available": "?boolean | boolean",
          "productUrl": "?string",
          "media": "array<object | object | object>"
        }
      },
      "shape": {
        "id": "string",
        "handle": "string",
        "variantId": "?string",
        "title": "string",
        "subtitle": "?string",
        "price": "string",
        "compareAtPrice": "?string",
        "badge": "?string",
        "available": "?boolean | boolean",
        "productUrl": "?string",
        "media": "array<{id: ?object, type: object, src: object, alt: ?object, mobileSrc: ?object, srcSet: ?object, srcSetWebp: ?object, sizes: ?object, fit: ?object, objectPosition: ?object} | {id: ?object, type: object, alt: ?object, poster: object, sources: object, preview: ?object, captionsUrl: ?object, assetId: ?object, provider: ?object, fit: ?object, objectPosition: ?object} | {id: ?object, type: ?object, src: ?object, url: ?object, alt: ?object, poster: ?object, mobileSrc: ?object, srcSet: ?object, srcSetWebp: ?object, sizes: ?object, fit: ?object, objectFit: ?object, objectPosition: ?object, sources: ?object, preview: ?object, captionsUrl: ?object, assetId: ?object, provider: ?object}>"
      },
      "required": false
    },
    "heading": {
      "type": "string",
      "required": false
    },
    "collectionLabel": {
      "type": "string",
      "required": false,
      "default": "Shop all"
    },
    "collectionUrl": {
      "type": "string",
      "required": false
    },
    "variant": {
      "type": "enum",
      "values": [
        "minimal",
        "fullBleed",
        "contained",
        "gallery"
      ],
      "required": false,
      "default": "fullBleed"
    },
    "activation": {
      "type": "enum",
      "values": [
        "hover",
        "click",
        "centered"
      ],
      "required": false,
      "default": "click"
    },
    "initialIndex": {
      "type": "number",
      "required": false,
      "default": "0"
    },
    "loop": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "autoplay": {
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    "interval": {
      "type": "number",
      "required": false,
      "default": "5000"
    },
    "mediaBehavior": {
      "type": "enum",
      "values": [
        "first",
        "hoverAdvance",
        "autoplay"
      ],
      "required": false,
      "default": "first"
    },
    "showBadges": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "showDetails": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "quickAddLabel": {
      "type": "string",
      "required": false,
      "default": "Quick add"
    },
    "quickAddOpenCart": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "animate": {
      "type": "union",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "required": false,
      "default": "true"
    },
    "className": {
      "type": "string",
      "required": false
    }
  },
  "variants": [
    "minimal",
    "fullBleed",
    "contained",
    "gallery"
  ],
