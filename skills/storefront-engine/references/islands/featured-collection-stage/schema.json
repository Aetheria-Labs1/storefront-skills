{
  "contract_version": 2,
  "name": "FeaturedCollectionStage",
  "category": "commerce",
  "capabilities": [
    {
      "name": "product:resolve"
    },
    {
      "name": "cart:add",
      "when": {
        "prop": "quickAdd.enabled",
        "notEquals": false
      }
    },
    {
      "name": "cart:open",
      "when": {
        "prop": "quickAdd.enabled",
        "notEquals": false
      }
    },
    {
      "name": "media:carousel"
    }
  ],
  "usage_hint": "Editorial multi-product collection stage with a shared backdrop, active-product details, image/video media, and CSS-first layout controls.",
  "when_to_use": "Use for featured collections, new arrivals, or best-seller sections where several large unframed products share one visual stage.",
  "when_not_to_use": "Not for conventional boxed product cards (use ProductCarousel) or a single product presentation (use ProductHero).",
  "defaultHydrate": "visible",
  "combine_with": [
    "Navbar",
    "Cart V2 via head.use_cart_v2",
    "AnnouncementBar"
  ],
  "anti_patterns": [
    "Using fewer than three products: the shared stage loses its collection context",
    "Adding nested carousels inside product media: horizontal gestures conflict with the collection rail",
    "Hardcoding item widths in authored HTML: use the exposed featured-stage CSS variables instead"
  ],
  "props": {
    "productIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "shape": {
          "id": "?string",
          "productId": "?string",
          "shopifyProductId": "?string",
          "handle": "?string",
          "title": "?string",
          "description": "?string",
          "subtitle": "?string",
          "badge": "?string",
          "productUrl": "?string",
          "price": "?string | {amount: object, currencyCode: object}",
          "compareAtPrice": "?unknown | string | {amount: object, currencyCode: object}",
          "availableForSale": "?boolean | boolean",
          "available": "?boolean | boolean",
          "media": "?array<object | object>",
          "options": "?array<object | object>",
          "variants": "?array<object | object>",
          "variantId": "?string"
        }
      },
      "shape": {
        "id": "?string",
        "productId": "?string",
        "shopifyProductId": "?string",
        "handle": "?string",
        "title": "?string",
        "description": "?string",
        "subtitle": "?string",
        "badge": "?string",
        "productUrl": "?string",
        "price": "?string | {amount: string, currencyCode: string}",
        "compareAtPrice": "?unknown | string | {amount: string, currencyCode: string}",
        "availableForSale": "?boolean | boolean",
        "available": "?boolean | boolean",
        "media": "?array<object | object>",
        "options": "?array<object | object>",
        "variants": "?array<object | object>",
        "variantId": "?string"
      },
      "required": false
    },
    "heading": {
      "type": "string",
      "required": false
    },
    "collectionLabel": {
      "type": "string",
      "required": false,
      "default": "Shop all"
    },
    "collectionUrl": {
      "type": "string",
      "required": false
    },
    "variant": {
      "type": "enum",
      "values": [
        "minimal",
        "fullBleed",
        "contained",
        "gallery"
      ],
      "required": false,
      "default": "fullBleed"
    },
    "activation": {
      "type": "enum",
      "values": [
        "hover",
        "click",
        "centered"
      ],
      "required": false,
      "default": "click"
    },
    "initialIndex": {
      "type": "number",
      "required": false,
      "default": "0"
    },
    "loop": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "autoplay": {
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    "interval": {
      "type": "number",
      "required": false,
      "default": "5000"
    },
    "mediaBehavior": {
      "type": "enum",
      "values": [
        "first",
        "hoverAdvance",
        "autoplay"
      ],
      "required": false,
      "default": "first"
    },
    "showBadges": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "showDetails": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "quickAdd": {
      "type": "union",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "shape": {
            "enabled": "?boolean | boolean",
            "placement": "?'media-top-right' | 'details-after' | 'custom'",
            "label": "?string",
            "openCartOnAdd": "?boolean | boolean",
            "picker": "?{desktop: ?object, mobile: ?object, title: ?object, closeOnAdd: ?object}"
          }
        }
      ],
      "required": false,
      "default": "true"
    },
    "quickAddLabel": {
      "type": "string",
      "required": false,
      "default": "Quick add"
    },
    "quickAddOpenCart": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "animate": {
      "type": "union",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        }
      ],
      "required": false,
      "default": "true"
    },
    "className": {
      "type": "string",
      "required": false
    }
  },
  "variants": [
    "minimal",
    "fullBleed",
    "contained",
    "gallery"
  ],
