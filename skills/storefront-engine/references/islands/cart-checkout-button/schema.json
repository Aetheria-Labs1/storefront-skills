{
  "contract_version": 2,
  "name": "CartCheckoutButton",
  "category": "commerce",
  "capabilities": [],
  "usage_hint": "Checkout CTA button that navigates to the Shopify checkout URL. Subscribes to shared cart state.",
  "when_to_use": "Inside DrawerShell below CartSummary as the primary cart action button.",
  "when_not_to_use": "Outside cart context. For generic CTAs use a plain link or button element.",
  "defaultHydrate": "immediate",
  "combine_with": [
    "DrawerShell",
    "CartSummary",
    "CartLines"
  ],
  "anti_patterns": [],
  "props": {
    "text": {
      "type": "string",
      "required": false,
      "default": "Checkout"
    },
    "style": {
      "type": "enum",
      "values": [
        "filled",
        "outline"
      ],
      "required": false,
      "default": "filled"
    },
    "secondaryCta": {
      "type": "object",
      "shape": {
        "label": "string",
        "url": "string"
      },
      "required": false
    },
    "showCartCount": {
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    "paymentProviders": {
      "type": "array",
      "items": {
        "type": "enum",
        "values": [
          "visa",
          "mastercard",
          "amex",
          "discover",
          "diners",
          "jcb",
          "paypal",
          "apple_pay",
          "google_pay",
          "shop_pay",
          "klarna",
          "afterpay",
          "affirm",
          "stripe",
          "cashapp",
          "upi",
          "phonepe",
          "razorpay",
          "paytm",
          "zip"
        ]
      },
      "required": false,
      "default": "[]"
    },
    "paymentPlacement": {
      "type": "enum",
      "values": [
        "inside_checkout",
        "below_checkout"
      ],
      "required": false,
      "default": "below_checkout"
    }
  },
  "variants": [
    "filled",
    "outline"
  ],
  "css_vars": [
    "--lx-accent-color",
    "--lx-text-color",
    "--lx-text-muted"
  ],
  "parts": [
    "button",
    "cta",
    "icons-row",
    "payment-logos",
    "provider",
    "provider-fallback",
    "provider-logo",
    "root",
    "secondary-cta",
    "text"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    }
  }
}
