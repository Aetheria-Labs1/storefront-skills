{
  "contract_version": 2,
  "name": "CountdownTimer",
  "category": "content",
  "usage_hint": "Live countdown timer for sales, launches, or deadlines. Updates every second. Three styles: simple (boxes + separators), flip (animated), circular (progress rings).",
  "when_to_use": "For flash sales, product launches, limited offers, event countdowns. Shows days/hours/minutes/seconds. Auto-hides when expired and shows expiredMessage. Supports custom CSS variables for styling.",
  "when_not_to_use": "For static \"Sale ends soon\" text use plain HTML. When deadline isn't firm (countdown creates urgency, broken promises hurt trust). For long durations (>30 days — use date instead).",
  "defaultHydrate": "immediate",
  "combine_with": [
    "Hero sections",
    "ProductPrice",
    "AnnouncementBar",
    "BuyBox"
  ],
  "anti_patterns": [
    "Setting endDate in the past (shows \"Time's up!\" immediately — test with future dates)",
    "Using countdown for evergreen \"fake urgency\" (resets on page load — customers notice and distrust)",
    "Placing multiple CountdownTimer instances for same deadline (redundant + confusing)"
  ],
  "props": {
    "endDate": {
      "type": "string",
      "required": true
    },
    "labels": {
      "type": "object",
      "shape": {
        "days": "?string",
        "hours": "?string",
        "minutes": "?string",
        "seconds": "?string"
      },
      "required": false,
      "default": "{}"
    },
    "expiredMessage": {
      "type": "string",
      "required": false,
      "default": "Time's up!"
    },
    "style": {
      "type": "enum",
      "values": [
        "flip",
        "simple",
        "circular",
        "headless"
      ],
      "required": false,
      "default": "simple"
    },
    "expiredAction": {
      "type": "enum",
      "values": [
        "hide",
        "message",
        "redirect"
      ],
      "required": false,
      "default": "message"
    },
    "redirectUrl": {
      "type": "string",
      "required": false
    }
  },
  "variants": [
    "flip",
    "simple",
    "circular",
    "headless"
  ],
  "css_vars": [
    "--lx-accent-color",
    "--lx-countdown-bg",
    "--lx-countdown-border",
    "--lx-countdown-font-size",
    "--lx-countdown-gap",
    "--lx-countdown-label-color",
    "--lx-countdown-label-size",
    "--lx-countdown-radius",
    "--lx-countdown-separator-color",
    "--lx-countdown-separator-size",
    "--lx-countdown-shadow",
    "--lx-countdown-size"
  ],
  "parts": [
    "box",
    "days",
    "digit",
    "expired",
    "hours",
    "label",
    "minutes",
    "ring",
    "root",
    "seconds",
    "separator",
    "unit"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    },
    "example": "<lx-island name=\"CountdownTimer\">\n  <script type=\"application/json\">\n{\n  \"endDate\": \"example-endDate\"\n}\n  </script>\n</lx-island>",
    "examples": [
      {
        "label": "Simple style flash sale",
        "source": "<lx-island name=\"CountdownTimer\">\n  <script type=\"application/json\">{\"endDate\":\"2026-12-31T23:59:59Z\",\"labels\":{\"days\":\"Days\",\"hours\":\"Hours\",\"minutes\":\"Min\",\"seconds\":\"Sec\"},\"expiredMessage\":\"Sale ended\",\"style\":\"simple\"}</script>\n</lx-island>"
      },
      {
        "label": "Circular progress style",
        "source": "<lx-island name=\"CountdownTimer\">\n  <script type=\"application/json\">{\"endDate\":\"2026-07-15T18:00:00Z\",\"labels\":{\"days\":\"D\",\"hours\":\"H\",\"minutes\":\"M\",\"seconds\":\"S\"},\"style\":\"circular\"}</script>\n</lx-island>"
      },
      {
        "label": "Flip style with custom message",
        "source": "<lx-island name=\"CountdownTimer\">\n  <script type=\"application/json\">{\"endDate\":\"2026-08-01T00:00:00Z\",\"expiredMessage\":\"Product launched! Shop now\",\"style\":\"flip\"}</script>\n</lx-island>"
      },
      {
        "label": "Headless countdown (style with section CSS)",
        "source": "<lx-island name=\"CountdownTimer\">\n  <script type=\"application/json\">{\"endDate\":\"2026-12-31T23:59:59Z\",\"style\":\"headless\"}</script>\n</lx-island>"
      }
    ]
  }
}
