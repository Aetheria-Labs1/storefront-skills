{
  "contract_version": 2,
  "name": "BundleBuilder",
  "category": "commerce",
  "capabilities": [
    {
      "name": "cart:add"
    },
    {
      "name": "cart:open"
    }
  ],
  "usage_hint": "Multi-product bundle or peer-set selector with optional discount and \"Add All to Cart\" action.",
  "when_to_use": "Use on PDP or collection pages for complementary bundles, gift sets, kits, and peer-product sets.",
  "when_not_to_use": "Not for single-product add-to-cart (use BuyBox or QuickAdd). Not for general product grids (use ProductCarousel). Not for cross-sells without bundle context (use ProductCarousel).",
  "defaultHydrate": "immediate",
  "combine_with": [
    "CartDrawer (REQUIRED for cart feedback)",
    "BuyBox (common on PDP pages)"
  ],
  "anti_patterns": [
    "Omitting CartDrawer: users get no cart confirmation feedback after clicking \"Add All\"",
    "Using without a discount: reduces incentive; bundle builders work best with visible savings",
    "Mixing incompatible products: bundle should make logical sense (e.g., phone + case + charger, not random items)",
    "Using layout:\"stacked\" with 5+ recommendations: becomes very tall; use horizontal layout or limit items"
  ],
  "props": {
    "mainProduct": {
      "type": "object",
      "shape": {
        "id": "string",
        "title": "string",
        "price": "string | {amount: object | object, currency_code: string}",
        "image": "string",
        "handle": "?string",
        "selected": "?boolean | boolean"
      },
      "required": false
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "shape": {
          "id": "string",
          "title": "string",
          "price": "string | {amount: object, currency_code: object}",
          "image": "string",
          "handle": "?string",
          "selected": "?boolean | boolean"
        }
      },
      "shape": {
        "id": "string",
        "title": "string",
        "price": "string | {amount: object | object, currency_code: string}",
        "image": "string",
        "handle": "?string",
        "selected": "?boolean | boolean"
      },
      "required": false,
      "default": "[]"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "shape": {
          "id": "string",
          "title": "string",
          "price": "string | {amount: object, currency_code: object}",
          "image": "string",
          "handle": "?string",
          "selected": "?boolean | boolean"
        }
      },
      "shape": {
        "id": "string",
        "title": "string",
        "price": "string | {amount: object | object, currency_code: string}",
        "image": "string",
        "handle": "?string",
        "selected": "?boolean | boolean"
      },
      "required": false
    },
    "bundleDiscount": {
      "type": "object",
      "shape": {
        "type": "'percentage' | 'fixed'",
        "value": "number"
      },
      "required": false
    },
    "title": {
      "type": "string",
      "required": false,
      "default": "Frequently bought together"
    },
    "layout": {
      "type": "enum",
      "values": [
        "horizontal",
        "stacked"
      ],
      "required": false,
      "default": "horizontal"
    },
    "showCheckboxes": {
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    "currencyCode": {
      "type": "string",
      "required": false
    },
    "locale": {
      "type": "string",
      "required": false
    }
  },
  "variants": [
    "horizontal",
    "stacked"
  ],
  "css_vars": [
    "--lx-accent-color",
    "--lx-text-color"
  ],
  "parts": [
    "cta",
    "heading",
    "item",
    "item-checkbox",
    "item-image",
    "item-price",
    "item-title",
    "main-image",
    "main-price",
    "main-product",
    "main-title",
    "pricing",
    "root",
    "savings-badge",
    "subtotal",
    "total"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    },
    "example": "<lx-island name=\"BundleBuilder\">\n  <script type=\"application/json\">\n{}\n  </script>\n</lx-island>",
    "examples": [
      {
        "label": "Stacked bundle with percentage discount",
        "source": "<lx-island name=\"BundleBuilder\">\n  <script type=\"application/json\">{\"mainProduct\":{\"id\":\"p1\",\"title\":\"Wireless Headphones\",\"price\":\"$99.00\",\"image\":\"https://via.placeholder.com/64\"},\"recommendations\":[{\"id\":\"p2\",\"title\":\"Carrying Case\",\"price\":\"$19.00\",\"image\":\"https://via.placeholder.com/64\"},{\"id\":\"p3\",\"title\":\"Audio Cable\",\"price\":\"$9.00\",\"image\":\"https://via.placeholder.com/64\"}],\"bundleDiscount\":{\"type\":\"percentage\",\"value\":10},\"title\":\"Complete Your Setup\",\"layout\":\"stacked\"}</script>\n</lx-island>"
      },
      {
        "label": "Horizontal bundle with fixed discount",
        "source": "<lx-island name=\"BundleBuilder\">\n  <script type=\"application/json\">{\"mainProduct\":{\"id\":\"p1\",\"title\":\"Camera\",\"price\":\"$499.00\",\"image\":\"https://via.placeholder.com/64\"},\"recommendations\":[{\"id\":\"p2\",\"title\":\"Lens\",\"price\":\"$199.00\",\"image\":\"https://via.placeholder.com/64\"},{\"id\":\"p3\",\"title\":\"Tripod\",\"price\":\"$49.00\",\"image\":\"https://via.placeholder.com/64\"}],\"bundleDiscount\":{\"type\":\"fixed\",\"value\":50},\"layout\":\"horizontal\"}</script>\n</lx-island>"
      },
      {
        "label": "Bundle without checkboxes (all items pre-selected)",
        "source": "<lx-island name=\"BundleBuilder\">\n  <script type=\"application/json\">{\"mainProduct\":{\"id\":\"p1\",\"title\":\"Laptop\",\"price\":\"$999.00\",\"image\":\"https://via.placeholder.com/64\"},\"recommendations\":[{\"id\":\"p2\",\"title\":\"Mouse\",\"price\":\"$29.00\",\"image\":\"https://via.placeholder.com/64\"}],\"showCheckboxes\":false,\"title\":\"Bundle & Save\"}</script>\n</lx-island>"
      },
      {
        "label": "INR peer gift set",
        "source": "<lx-island name=\"BundleBuilder\">\n  <script type=\"application/json\">{\"products\":[{\"id\":\"gid://shopify/ProductVariant/1\",\"title\":\"6 Mukhi Bracelet\",\"price\":{\"amount\":\"1899\",\"currency_code\":\"INR\"},\"image\":\"https://example.com/bracelet.jpg\"},{\"id\":\"gid://shopify/ProductVariant/2\",\"title\":\"Citrine Mala\",\"price\":{\"amount\":\"1399\",\"currency_code\":\"INR\"},\"image\":\"https://example.com/mala.jpg\"}],\"bundleDiscount\":{\"type\":\"fixed\",\"value\":200},\"title\":\"Build the gift set\",\"layout\":\"horizontal\"}</script>\n</lx-island>"
      }
    ]
  }
}
