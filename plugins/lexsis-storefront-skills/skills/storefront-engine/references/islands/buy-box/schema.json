{
  "contract_version": 2,
  "name": "BuyBox",
  "category": "commerce",
  "usage_hint": "Full-featured product purchase interface with variant selection, quantity picker, and add-to-cart functionality. Primary CTA for PDP layouts.",
  "when_to_use": "Use on product detail pages where customers need to select options and add items to cart. Supports variants, subscription plans, out-of-stock notify-me, and animated feedback.",
  "when_not_to_use": "Not for collection pages (use QuickAdd instead). Not for sticky follow-up CTAs (use StickyBar). Not for lightweight inline add-to-cart (use QuickAdd).",
  "defaultHydrate": "immediate",
  "combine_with": [
    "CartDrawer (REQUIRED for cart feedback)",
    "ProductGallery or ProductHero (visual context)",
    "VariantSwatches (when listenForEvents:true + showVariantSelector:false)"
  ],
  "anti_patterns": [
    "Omitting CartDrawer: without it, users don't see cart confirmation feedback or access the cart",
    "Using showVariantSelector:true with VariantSwatches: duplicates variant UI (set showVariantSelector:false, listenForEvents:true on BuyBox when using VariantSwatches)",
    "Variant=\"compact\" with multiple variants: loses variant selector, breaking multi-variant products",
    "Setting animate:false then relying on success feedback: removes visual confirmation animations"
  ],
  "props": {
    "product": {
      "type": "object",
      "shape": {
        "title": "string",
        "price": "string",
        "compareAtPrice": "?string",
        "variants": "array<{id: string, title: string, price: string, available: boolean}>"
      },
      "required": true
    },
    "ctaText": {
      "type": "string",
      "required": false
    },
    "listenForEvents": {
      "type": "boolean",
      "required": false
    },
    "showVariantSelector": {
      "type": "boolean",
      "required": false
    },
    "showPrice": {
      "type": "boolean",
      "required": false
    },
    "showTrustBadges": {
      "type": "boolean",
      "required": false
    },
    "variant": {
      "type": "enum",
      "values": [
        "default",
        "compact",
        "expanded"
      ],
      "required": false
    },
    "animate": {
      "type": "union",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "required": false
    },
    "buttonStyle": {
      "type": "object",
      "shape": {
        "borderRadius": "?string",
        "padding": "?string",
        "fontSize": "?string"
      },
      "required": false
    },
    "__originalHtml": {
      "type": "string",
      "required": false
    }
  },
  "variants": [
    "default",
    "compact",
    "expanded"
  ],
  "css_vars": [
    "--lx-accent-color"
  ],
  "parts": [
    "cta",
    "notify",
    "qty",
    "qty-btn",
    "root",
    "trust-badges",
    "variant-btn",
    "variants"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate",
      "headless"
    ],
    "headless": {
      "supported": true,
      "hooks": [
        "add",
        "price",
        "compare-price",
        "variant-option",
        "qty",
        "qty-inc",
        "qty-dec",
        "stock",
        "error"
      ]
    },
    "example": "<lx-island name=\"BuyBox\">\n  <script type=\"application/json\">\n{\n  \"product\": {\n    \"title\": \"example-title\",\n    \"price\": \"example-price\",\n    \"variants\": []\n  }\n}\n  </script>\n</lx-island>",
    "examples": [
      {
        "label": "Default PDP BuyBox with variants",
        "source": "<lx-island name=\"BuyBox\">\n  <script type=\"application/json\">{\"product\":{\"title\":\"Wireless Headphones\",\"price\":\"$99.00\",\"compareAtPrice\":\"$129.00\",\"variants\":[{\"id\":\"v1\",\"title\":\"Black\",\"price\":\"$99.00\",\"available\":true},{\"id\":\"v2\",\"title\":\"White\",\"price\":\"$99.00\",\"available\":true}]},\"ctaText\":\"Add to Cart\",\"showVariantSelector\":true,\"variant\":\"default\"}</script>\n</lx-island>"
      },
      {
        "label": "Compact BuyBox (single variant, no qty picker)",
        "source": "<lx-island name=\"BuyBox\">\n  <script type=\"application/json\">{\"product\":{\"title\":\"T-Shirt\",\"price\":\"$29.00\",\"variants\":[{\"id\":\"v1\",\"title\":\"Medium\",\"price\":\"$29.00\",\"available\":true}]},\"variant\":\"compact\"}</script>\n</lx-island>"
      },
      {
        "label": "Expanded with trust badges",
        "source": "<lx-island name=\"BuyBox\">\n  <script type=\"application/json\">{\"product\":{\"title\":\"Premium Watch\",\"price\":\"$299.00\",\"variants\":[{\"id\":\"v1\",\"title\":\"Silver\",\"price\":\"$299.00\",\"available\":true}]},\"variant\":\"expanded\",\"ctaText\":\"Buy Now\"}</script>\n</lx-island>"
      },
      {
        "label": "No price (custom price layout above)",
        "source": "<lx-island name=\"BuyBox\">\n  <script type=\"application/json\">{\"product\":{\"title\":\"Sneakers\",\"price\":\"$120.00\",\"variants\":[{\"id\":\"v1\",\"title\":\"Red\",\"price\":\"$120.00\",\"available\":true}]},\"showPrice\":false}</script>\n</lx-island>"
      },
      {
        "label": "Expanded without trust badges",
        "source": "<lx-island name=\"BuyBox\">\n  <script type=\"application/json\">{\"product\":{\"title\":\"Serum\",\"price\":\"$49.00\",\"variants\":[{\"id\":\"v1\",\"title\":\"30ml\",\"price\":\"$49.00\",\"available\":true}]},\"variant\":\"expanded\",\"showTrustBadges\":false}</script>\n</lx-island>"
      },
      {
        "label": "With VariantSwatches (event-driven, no internal selector)",
        "source": "<lx-island name=\"BuyBox\">\n  <script type=\"application/json\">{\"product\":{\"title\":\"Sneakers\",\"price\":\"$120.00\",\"variants\":[{\"id\":\"v1\",\"title\":\"Red\",\"price\":\"$120.00\",\"available\":true}]},\"listenForEvents\":true,\"showVariantSelector\":false}</script>\n</lx-island>"
      },
      {
        "label": "HEADLESS — fully custom markup, behavior via data-lx-buybox hooks (add is required; variant-option needs data-variant-id; state classes lx-selected/lx-disabled/lx-adding/lx-added)",
        "source": "<lx-island name=\"BuyBox\" headless>\n  <script type=\"application/json\">{\"product\":{\"title\":\"Serum\",\"price\":\"$49.00\",\"variants\":[{\"id\":\"v1\",\"title\":\"30ml\",\"price\":\"$49.00\",\"available\":true},{\"id\":\"v2\",\"title\":\"50ml\",\"price\":\"$69.00\",\"available\":true}]}}</script>\n  <p class=\"text-3xl font-bold\" data-lx-buybox=\"price\">$49.00</p><div class=\"flex gap-2\"><button data-lx-buybox=\"variant-option\" data-variant-id=\"v1\" class=\"px-4 py-2 border rounded-full\">30ml</button><button data-lx-buybox=\"variant-option\" data-variant-id=\"v2\" class=\"px-4 py-2 border rounded-full\">50ml</button></div><div class=\"flex items-center gap-3\"><button data-lx-buybox=\"qty-dec\">−</button><span data-lx-buybox=\"qty\">1</span><button data-lx-buybox=\"qty-inc\">+</button></div><button data-lx-buybox=\"add\" class=\"w-full py-4 rounded-full text-white\" style=\"background: var(--lx-accent-color)\">Add to Cart</button><p data-lx-buybox=\"error\" class=\"text-red-600 text-sm\">Couldn't add — try again.</p>\n</lx-island>"
      }
    ]
  }
}
