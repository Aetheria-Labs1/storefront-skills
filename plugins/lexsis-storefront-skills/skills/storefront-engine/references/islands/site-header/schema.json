{
  "contract_version": 2,
  "name": "SiteHeader",
  "category": "navigation",
  "capabilities": [
    {
      "name": "cart:open"
    }
  ],
  "usage_hint": "Combined announcement bar + navigation bar in one unified header component. Announcement supports rotation, dismissal, and session persistence.",
  "when_to_use": "When you need both announcement bar and navigation in a single sticky header unit. Announcement auto-rotates messages, persists dismissal in sessionStorage. Use this OR (Navbar + AnnouncementBar separately), not both.",
  "when_not_to_use": "If you only need navigation without announcement, use Navbar alone. If announcement should scroll away while nav stays sticky, use separate AnnouncementBar + Navbar.",
  "defaultHydrate": "immediate",
  "combine_with": [
    "CartDrawer",
    "Footer",
    "BackToTop"
  ],
  "anti_patterns": [
    "Using SiteHeader AND Navbar on the same page — they duplicate functionality",
    "Multiple SiteHeader instances — there should be one site-wide header",
    "Setting announcement messages that are too long (causes mobile overflow — keep under 60 chars)"
  ],
  "props": {
    "announcement": {
      "type": "object",
      "shape": {
        "messages": "array<string>",
        "speed": "?number",
        "backgroundColor": "?string",
        "textColor": "?string",
        "dismissible": "?boolean | boolean",
        "link": "?string"
      },
      "required": false
    },
    "navbar": {
      "type": "object",
      "shape": {
        "logo": "{src: ?string, text: ?string, alt: ?string, url: ?string}",
        "links": "array<{label: string, url: string, children: ?array<{}>}>",
        "cartCount": "?number",
        "transparent": "?boolean | boolean",
        "style": "?{bgColor: ?object, textColor: ?object, accentColor: ?object, logoHeight: ?object, height: ?object, borderBottom: ?object, fontFamily: ?object, fontSize: ?object, fontWeight: ?object, padding: ?object, maxWidth: ?object, dropdownBg: ?object, dropdownTextColor: ?object, mobileBg: ?object, mobileTextColor: ?object}",
        "cta": "?{label: string, url: string}",
        "hideCart": "?boolean | boolean"
      },
      "required": false
    },
    "sticky": {
      "type": "boolean",
      "required": false
    },
    "cartMode": {
      "type": "enum",
      "values": [
        "drawer",
        "link"
      ],
      "required": false
    },
    "cartUrl": {
      "type": "string",
      "required": false
    },
    "transparent": {
      "type": "boolean",
      "required": false
    },
    "offsetTop": {
      "type": "string",
      "required": false
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": false
    },
    "rotateInterval": {
      "type": "number",
      "required": false
    },
    "dismissible": {
      "type": "boolean",
      "required": false
    },
    "hideCart": {
      "type": "boolean",
      "required": false
    }
  },
  "variants": null,
  "css_vars": [
    "--lx-accent-color"
  ],
  "parts": [
    "announcement",
    "announcement-dismiss",
    "announcement-text",
    "cart-badge",
    "cart-trigger",
    "cta",
    "dropdown",
    "dropdown-item",
    "link",
    "links",
    "logo",
    "mobile-link",
    "mobile-panel",
    "mobile-trigger",
    "nav",
    "root"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    },
    "example": "<lx-island name=\"SiteHeader\">\n  <script type=\"application/json\">\n{}\n  </script>\n</lx-island>",
    "examples": [
      {
        "label": "Hydration mode with rotating announcements",
        "source": "<lx-island name=\"SiteHeader\">\n  <script type=\"application/json\">{\"sticky\":true,\"cartMode\":\"drawer\",\"messages\":[\"Free shipping over $50\",\"New arrivals daily\",\"20% off first order\"],\"rotateInterval\":5000,\"dismissible\":true}</script>\n  <header data-lx-header=\"root\"><div data-lx-header=\"announcement\"><span data-lx-header=\"announcement-text\"></span><button data-lx-header=\"announcement-dismiss\">×</button></div><nav data-lx-nav=\"root\">...</nav></header>\n</lx-island>"
      },
      {
        "label": "Legacy mode with text wordmark",
        "source": "<lx-island name=\"SiteHeader\">\n  <script type=\"application/json\">{\"announcement\":{\"messages\":[\"Sale ends tonight!\"],\"backgroundColor\":\"#5055aa\",\"dismissible\":false},\"navbar\":{\"logo\":{\"text\":\"Northstar\"},\"links\":[{\"label\":\"Shop\",\"url\":\"/shop\"}],\"transparent\":true},\"sticky\":true}</script>\n</lx-island>"
      },
      {
        "label": "Legacy mode with linked announcement",
        "source": "<lx-island name=\"SiteHeader\">\n  <script type=\"application/json\">{\"announcement\":{\"messages\":[\"Click here for 20% off\"],\"link\":\"/sale\",\"backgroundColor\":\"#000\",\"textColor\":\"#fff\"},\"navbar\":{\"logo\":{\"src\":\"/logo.svg\"},\"links\":[{\"label\":\"Products\",\"url\":\"/products\"}]}}</script>\n</lx-island>"
      }
    ]
  }
}
