{
  "contract_version": 2,
  "name": "QuickAdd",
  "category": "commerce",
  "usage_hint": "Lightweight add-to-cart button for collection pages. Shows single-variant instant add or multi-variant dropdown selector. Used inside ProductCarousel or standalone in grids.",
  "when_to_use": "Use on collection pages where space is limited and you need quick add-to-cart without navigating to PDP. Ideal for cards, grids, and list views.",
  "when_not_to_use": "Not for PDP main purchase UI (use BuyBox). Not for sticky follow-up CTAs (use StickyBar). Not when you need quantity selection or detailed variant info (use BuyBox).",
  "defaultHydrate": "interaction",
  "combine_with": [
    "CartDrawer (REQUIRED for cart feedback)",
    "ProductCarousel (QuickAdd is commonly used inside product grids)"
  ],
  "anti_patterns": [
    "Using on PDP: wrong pattern; PDP should use BuyBox for full purchase experience",
    "Omitting CartDrawer: users get no cart confirmation feedback",
    "Using for products with many variants (5+): dropdown becomes unwieldy; navigate to PDP instead",
    "Setting animate:false globally: removes dropdown scale-in and success checkmark animations"
  ],
  "props": {
    "product": {
      "type": "object",
      "shape": {
        "title": "string",
        "variants": "array<{id: string, title: string, price: string, available: boolean}>",
        "image": "?string"
      },
      "required": true
    },
    "render": {
      "type": "enum",
      "values": [
        "minimal",
        "button",
        "icon",
        "custom-trigger"
      ],
      "required": false,
      "default": "button"
    },
    "iconSize": {
      "type": "number",
      "required": false
    },
    "triggerSelector": {
      "type": "string",
      "required": false
    },
    "animate": {
      "type": "union",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "required": false,
      "default": "true"
    }
  },
  "variants": null,
  "css_vars": [
    "--lx-accent-color",
    "--lx-quickadd-bg",
    "--lx-quickadd-color",
    "--lx-quickadd-radius",
    "--lx-quickadd-size"
  ],
  "parts": [
    "dropdown",
    "dropdown-label",
    "root",
    "variant-btn"
  ],
  "authoring": {
    "format": "source-html",
    "element": "lx-island",
    "props_encoding": "script[type=application/json]",
    "allowed_attributes": [
      "class",
      "id",
      "style",
      "hydrate"
    ],
    "headless": {
      "supported": false
    },
    "example": "<lx-island name=\"QuickAdd\">\n  <script type=\"application/json\">\n{\n  \"product\": {\n    \"title\": \"example-title\",\n    \"variants\": []\n  }\n}\n  </script>\n</lx-island>",
    "examples": [
      {
        "label": "Single-variant quick add",
        "source": "<lx-island name=\"QuickAdd\">\n  <script type=\"application/json\">{\"product\":{\"title\":\"T-Shirt\",\"variants\":[{\"id\":\"v1\",\"title\":\"Medium\",\"price\":\"$29.00\",\"available\":true}]}}</script>\n</lx-island>"
      },
      {
        "label": "Multi-variant quick add with dropdown",
        "source": "<lx-island name=\"QuickAdd\">\n  <script type=\"application/json\">{\"product\":{\"title\":\"Sneakers\",\"variants\":[{\"id\":\"v1\",\"title\":\"Size 8\",\"price\":\"$120.00\",\"available\":true},{\"id\":\"v2\",\"title\":\"Size 9\",\"price\":\"$120.00\",\"available\":true},{\"id\":\"v3\",\"title\":\"Size 10\",\"price\":\"$120.00\",\"available\":false}],\"image\":\"https://via.placeholder.com/64\"}}</script>\n</lx-island>"
      },
      {
        "label": "Quick add without animations",
        "source": "<lx-island name=\"QuickAdd\">\n  <script type=\"application/json\">{\"product\":{\"title\":\"Hat\",\"variants\":[{\"id\":\"v1\",\"title\":\"One Size\",\"price\":\"$19.00\",\"available\":true}]},\"animate\":false}</script>\n</lx-island>"
      },
      {
        "label": "Icon mode quick add",
        "source": "<lx-island name=\"QuickAdd\">\n  <script type=\"application/json\">{\"product\":{\"title\":\"T-Shirt\",\"variants\":[{\"id\":\"v1\",\"title\":\"Medium\",\"price\":\"$29.00\",\"available\":true}]},\"render\":\"icon\",\"iconSize\":40}</script>\n</lx-island>"
      },
      {
        "label": "Minimal plus button",
        "source": "<lx-island name=\"QuickAdd\">\n  <script type=\"application/json\">{\"product\":{\"title\":\"T-Shirt\",\"variants\":[{\"id\":\"v1\",\"title\":\"Medium\",\"price\":\"$29.00\",\"available\":true}]},\"render\":\"minimal\",\"iconSize\":32}</script>\n</lx-island>"
      }
    ]
  }
}
